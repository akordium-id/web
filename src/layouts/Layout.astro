---
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import WhatsAppIcon from '../components/common/WhatsAppIcon.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Akordium Lab | Smarter IT. Stronger Business.',
  description = 'Akordium Lab menghadirkan solusi IT modern: pengembangan web & aplikasi, infrastruktur cloud, dan pelatihan teknologi untuk bisnis Indonesia.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Akordium Lab" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/og-image.png" />
    
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&family=Source+Serif+4:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="font-body antialiased text-stone-800 bg-stone-50" data-font-pair="modern">
    <Navbar />
    <main id="main-content" class="min-h-screen" style="padding-top: var(--nav-height)">
      <slot />
    </main>
    <Footer />
    
    <!-- Floating WhatsApp Button (Mobile & Desktop) -->
    <a
      href="https://wa.me/628159988995?text=Halo%20Akordium%20Lab,%20saya%20ingin%20konsultasi%20kebutuhan%20sistem"
      target="_blank"
      rel="noopener noreferrer"
      class="whatsapp-float group"
      aria-label="Chat via WhatsApp"
    >
      <WhatsAppIcon class="w-6 h-6 shrink-0 text-white transition-transform group-hover:scale-110" />
      <span class="whatsapp-label font-sans font-semibold text-sm tracking-tight text-white pr-1">Konsultasi WhatsApp</span>
    </a>
    
    <script>
      const params = new URLSearchParams(window.location.search);
      const fromQuery = params.get('font');
      const fromStorage = window.localStorage.getItem('akordium-font-pair');
      const selected = fromQuery || fromStorage || 'modern';
      const isValid = selected === 'modern' || selected === 'editorial';
      const finalPair = isValid ? selected : 'modern';

      document.body.setAttribute('data-font-pair', finalPair);
      window.localStorage.setItem('akordium-font-pair', finalPair);
    </script>
  </body>
</html>

<style>
  .whatsapp-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100;
    height: 52px;
    background-color: #25D366;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35);
    transition: transform 0.2s, box-shadow 0.2s;
    color: white;
    text-decoration: none;
    padding: 0 16px;
    gap: 8px;
  }
  .whatsapp-float:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
  }
  @media (max-width: 767px) {
    .whatsapp-float {
      width: 52px;
      height: 52px;
      padding: 0;
      border-radius: 50%;
    }
    .whatsapp-label {
      display: none;
    }
  }
</style>