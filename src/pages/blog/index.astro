---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CTA from '../../components/home/CTA.astro';

const blogPosts = await getCollection("blog");
blogPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const featuredPost = blogPosts[0];
const restPosts = blogPosts.slice(1);
---

<Layout title="Blog | Akordium Lab" description="Artikel, tips, dan insights seputar teknologi IT untuk bisnis Indonesia dari tim Akordium Lab.">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-linear-to-br from-white via-primary-50/50 to-accent-50/30 pt-20 pb-16 lg:pb-20 border-b border-stone-200/70 mb-12">
    <!-- Ambient glows -->
    <div class="absolute -top-40 -right-40 w-120 h-120 rounded-full bg-primary-100/60 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-120 h-120 rounded-full bg-accent-100/40 blur-3xl pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #000 1px, transparent 1px); background-size: 24px 24px;"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 bg-primary-50 border border-primary-200/80 rounded-full px-4 py-1.5 mb-6 text-xs font-semibold text-primary-900 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-600 animate-pulse"></span>
        Artikel & Riset
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-stone-900 mb-4 leading-tight">
        Insights & Inovasi
      </h1>
      <p class="text-lg text-stone-600 max-w-2xl mx-auto leading-relaxed">
        Tips teknologi, arsitektur software, dan strategi digital dari tim Akordium Lab untuk mendorong efisiensi bisnis Anda.
      </p>
    </div>
  </section>

  <!-- Featured Post -->
  {featuredPost && (
    <section class="pb-16 lg:pb-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <a href={`/blog/${featuredPost.data.slug}`} class="group block">
          <div class="bg-white rounded-2xl overflow-hidden border border-slate-100 hover:border-primary-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="grid lg:grid-cols-2">
              <div class="relative overflow-hidden aspect-[16/9] lg:aspect-auto lg:min-h-[420px]">
                <img
                  src={featuredPost.data.image}
                  alt={featuredPost.data.titleId}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="eager"
                />
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1.5 bg-primary-900 text-white text-xs font-semibold rounded-lg shadow-sm">
                    {featuredPost.data.category}
                  </span>
                </div>
              </div>
              <div class="p-8 lg:p-10 flex flex-col justify-center">
                <div class="flex items-center gap-3 text-sm text-slate-400 mb-4">
                  <span>{featuredPost.data.date}</span>
                  <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                  <span>{featuredPost.data.readTime}</span>
                </div>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 leading-tight mb-4 group-hover:text-primary-900 transition-colors">
                  {featuredPost.data.titleId}
                </h2>
                <p class="text-slate-500 leading-relaxed line-clamp-3 mb-6">
                  {featuredPost.data.excerptId}
                </p>
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center">
                    <span class="text-primary-900 font-bold text-sm">{featuredPost.data.author.charAt(0)}</span>
                  </div>
                  <div>
                    <span class="text-sm font-semibold text-slate-700 block">{featuredPost.data.author}</span>
                    <span class="text-xs text-slate-400">Author</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Blog Grid -->
  <section class="pb-20 lg:pb-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 gap-8">
        {restPosts.map(post => (
          <a href={`/blog/${post.data.slug}`} class="group block">
            <div class="bg-white rounded-2xl overflow-hidden border border-slate-100 hover:border-primary-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
              <div class="relative overflow-hidden aspect-video">
                <img
                  src={post.data.image}
                  alt={post.data.titleId}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3">
                  <span class="px-2.5 py-1 bg-primary-900 text-white text-xs font-semibold rounded-lg shadow-sm">
                    {post.data.category}
                  </span>
                </div>
              </div>
              <div class="p-6">
                <div class="flex items-center gap-2 text-sm text-slate-400 mb-3">
                  <span>{post.data.date}</span>
                  <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                  <span>{post.data.readTime}</span>
                </div>
                <h2 class="font-bold text-slate-900 text-lg leading-snug mb-2 group-hover:text-primary-900 transition-colors">
                  {post.data.titleId}
                </h2>
                <p class="text-slate-500 text-sm leading-relaxed line-clamp-2 mb-4">{post.data.excerptId}</p>
                <div class="flex items-center gap-1.5 text-sm font-semibold text-primary-900 group-hover:text-accent-600 group-hover:gap-3 transition-all">
                  Baca Selengkapnya
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTA
    eyebrow="Diskusi & Kolaborasi"
    title="Ada tantangan sistem yang ingin Anda selesaikan?"
    description="Tim kami siap membantu Anda mengimplementasikan solusi software dan arsitektur yang tepat untuk bisnis Anda."
    whatsappText="Halo Akordium Lab, saya membaca artikel di blog Akordium dan ingin berdiskusi lebih lanjut"
  />
</Layout>
