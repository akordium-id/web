---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CTA from '../../components/home/CTA.astro';

const blogPosts = await getCollection("blog");
blogPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const featuredPost = blogPosts[0];
const restPosts = blogPosts.slice(1);
const categories = ["Semua", ...new Set(blogPosts.map(p => p.data.category))];
---

<Layout title="Blog & Riset | Akordium Lab" description="Artikel, panduan teknis, dan wawasan seputar arsitektur software, sistem operasional, dan efisiensi digital untuk bisnis Indonesia.">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-linear-to-br from-white via-primary-50/50 to-accent-50/30 pt-20 pb-16 lg:pb-20 border-b border-stone-200/70 mb-12">
    <!-- Ambient glows -->
    <div class="absolute -top-40 -right-40 w-120 h-120 rounded-full bg-primary-100/60 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-120 h-120 rounded-full bg-accent-100/40 blur-3xl pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #000 1px, transparent 1px); background-size: 24px 24px;"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 bg-primary-50 border border-primary-200/80 rounded-full px-4 py-1.5 mb-6 text-xs font-semibold text-primary-900 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-600 animate-pulse"></span>
        Artikel & Wawasan Rekayasa IT
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-stone-900 mb-4 leading-tight">
        Wawasan, Panduan & <br class="hidden sm:inline" />
        <span class="text-accent-600">Praktik Lapangan</span>
      </h1>
      <p class="text-lg text-stone-600 max-w-2xl mx-auto leading-relaxed">
        Catatan langsung dari pengalaman membangun sistem backend, database berskala tinggi, otomasi alur kerja, dan efisiensi digital bisnis di Indonesia.
      </p>

      <!-- Category Filter Pills -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
        {categories.map((cat, idx) => (
          <span class={`px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all ${
            idx === 0
              ? 'bg-primary-900 text-white shadow-xs'
              : 'bg-white/80 text-stone-600 border border-stone-200/80 hover:border-primary-300 hover:text-primary-900'
          }`}>
            {cat}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Post -->
  {featuredPost && (
    <section class="pb-16 lg:pb-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-4 flex items-center gap-2 text-xs font-bold text-accent-700 uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-accent-600"></span>
          Artikel Pilihan Terbaru
        </div>

        <a href={`/blog/${featuredPost.data.slug}`} class="group block">
          <div class="bg-white rounded-3xl overflow-hidden border border-stone-200/90 shadow-sm hover:border-primary-300 hover:shadow-2xl hover:shadow-primary-950/5 transition-all duration-300">
            <div class="grid lg:grid-cols-12 items-stretch">
              <!-- Image Column -->
              <div class="lg:col-span-6 relative overflow-hidden aspect-[16/10] lg:aspect-auto lg:min-h-[440px] bg-stone-900">
                <img
                  src={featuredPost.data.image}
                  alt={featuredPost.data.titleId}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0a142e]/70 via-transparent to-transparent pointer-events-none"></div>
                <div class="absolute top-4 left-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-primary-900 text-white text-xs font-bold rounded-full shadow-md border border-white/15">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent-400"></span>
                    {featuredPost.data.category}
                  </span>
                </div>
              </div>

              <!-- Content Column -->
              <div class="lg:col-span-6 p-8 sm:p-10 lg:p-12 flex flex-col justify-center">
                <div class="flex items-center gap-3 text-xs text-stone-400 font-medium mb-4">
                  <span class="flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    {featuredPost.data.date}
                  </span>
                  <span class="w-1 h-1 rounded-full bg-stone-300"></span>
                  <span class="flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    {featuredPost.data.readTime}
                  </span>
                </div>

                <h2 class="font-sans text-2xl sm:text-3xl lg:text-4xl font-extrabold text-stone-900 leading-tight mb-4 group-hover:text-primary-900 transition-colors">
                  {featuredPost.data.titleId}
                </h2>

                <p class="text-stone-600 text-sm sm:text-base leading-relaxed line-clamp-3 mb-8">
                  {featuredPost.data.excerptId}
                </p>

                <div class="flex items-center justify-between gap-4 pt-6 border-t border-stone-100 mt-auto">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-primary-50 border border-primary-100 flex items-center justify-center text-primary-900 font-bold text-sm">
                      {featuredPost.data.author.charAt(0)}
                    </div>
                    <div>
                      <span class="text-xs font-bold text-stone-900 block">{featuredPost.data.author}</span>
                      <span class="text-[11px] text-stone-400">Engineering & Strategy</span>
                    </div>
                  </div>

                  <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-primary-900 group-hover:text-accent-600 transition-colors">
                    Baca Artikel Lengkap
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Blog Grid -->
  <section class="pb-24 lg:pb-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-stone-200/80">
        <div>
          <h2 class="font-sans text-2xl font-bold text-stone-900">Arsip Publikasi</h2>
          <p class="text-xs sm:text-sm text-stone-500 mt-0.5">Kumpulan artikel, tips sistem informasi, dan dokumentasi arsitektur.</p>
        </div>
        <span class="text-xs font-semibold px-3 py-1 rounded-full bg-stone-100 text-stone-600 border border-stone-200">
          {blogPosts.length} Artikel
        </span>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {restPosts.map(post => (
          <a href={`/blog/${post.data.slug}`} class="group flex flex-col h-full bg-white rounded-3xl overflow-hidden border border-stone-200/80 hover:border-primary-300 hover:shadow-xl hover:shadow-primary-950/5 hover:-translate-y-1 transition-all duration-300">
            <div class="relative overflow-hidden aspect-[16/10] bg-stone-900">
              <img
                src={post.data.image}
                alt={post.data.titleId}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0a142e]/50 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute top-3 left-3">
                <span class="inline-flex items-center px-2.5 py-0.5 bg-primary-900/90 backdrop-blur-xs text-white text-[11px] font-semibold rounded-full border border-white/10 shadow-xs">
                  {post.data.category}
                </span>
              </div>
            </div>
            <div class="p-6 sm:p-7 flex flex-col flex-1">
              <div class="flex items-center gap-2.5 text-xs text-stone-400 font-medium mb-3">
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  {post.data.date}
                </span>
                <span class="w-1 h-1 rounded-full bg-stone-300"></span>
                <span>{post.data.readTime}</span>
              </div>
              <h3 class="font-sans font-bold text-stone-900 text-lg leading-snug mb-3 group-hover:text-primary-900 transition-colors line-clamp-2">
                {post.data.titleId}
              </h3>
              <p class="text-stone-500 text-sm leading-relaxed line-clamp-2 mb-6 flex-1">
                {post.data.excerptId}
              </p>
              <div class="flex items-center justify-between pt-4 border-t border-stone-100 mt-auto">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-primary-50 border border-primary-100 flex items-center justify-center text-primary-900 font-bold text-xs">
                    {post.data.author.charAt(0)}
                  </div>
                  <span class="text-xs text-stone-600 font-medium">{post.data.author}</span>
                </div>
                <div class="flex items-center gap-1 text-xs font-bold text-primary-900 group-hover:text-accent-600 group-hover:gap-2 transition-all">
                  Baca
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTA
    eyebrow="Riset & Diskusi Teknis"
    title="Punya tantangan arsitektur atau sistem yang ingin dibahas?"
    description="Tim engineer Akordium Lab terbuka untuk konsultasi teknis seputar arsitektur Go, PostgreSQL, migrasi sistem, hingga dashboard telemetri bisnis Anda."
    whatsappText="Halo Akordium Lab, saya membaca blog Akordium dan ingin berdiskusi mengenai kebutuhan sistem kami"
  />
</Layout>
