---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
  }));
}

const { slug } = Astro.params;
const posts = await getCollection("blog");
const post = posts.find(p => p.data.slug === slug);

if (!post) return Astro.redirect("/blog");

const { Content } = await render(post);
const relatedPosts = posts
  .filter(p => p.data.slug !== slug)
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);
---

<Layout title={`${post.data.titleId} | Akordium Lab Blog`} description={post.data.excerptId}>
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="max-w-3xl mx-auto mb-12">
        <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-accent-600 transition-colors mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
          Kembali ke Blog
        </a>

        <span class="inline-block px-3 py-1 bg-accent-50 border border-accent-200/60 text-accent-700 text-xs font-semibold rounded-full uppercase tracking-wider mb-5">
          {post.data.category}
        </span>

        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-4 leading-tight">
          {post.data.titleId}
        </h1>
        <p class="text-lg text-slate-500 italic mb-6">{post.data.title}</p>

        <div class="flex flex-wrap items-center gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center">
              <span class="text-primary-900 font-bold text-sm">{post.data.author.charAt(0)}</span>
            </div>
            <div>
              <span class="text-sm font-semibold text-slate-700 block">{post.data.author}</span>
              <span class="text-xs text-slate-400">Author</span>
            </div>
          </div>
          <div class="hidden sm:block w-px h-8 bg-slate-200"></div>
          <div class="flex items-center gap-3 text-sm text-slate-400">
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              {post.data.date}
            </div>
            <span class="w-1 h-1 rounded-full bg-slate-300"></span>
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              {post.data.readTime}
            </div>
          </div>
        </div>
      </div>

      <!-- Featured Image -->
      <div class="max-w-5xl mx-auto mb-12">
        <img
          src={post.data.image}
          alt={post.data.titleId}
          class="w-full h-64 sm:h-80 lg:h-[28rem] object-cover rounded-2xl shadow-xl shadow-slate-200 border border-slate-200"
          loading="lazy"
        />
      </div>

      <!-- Article Content -->
      <div class="max-w-3xl mx-auto">
        <div class="prose prose-slate prose-lg max-w-none">
          <p class="text-xl text-slate-600 font-medium mb-8 leading-relaxed border-l-4 border-accent-600 pl-6 bg-slate-50 py-4 rounded-r-xl">
            {post.data.excerptId}
          </p>
          <Content />
        </div>

        <!-- Author Bio -->
        <div class="mt-16 p-6 lg:p-8 bg-slate-50 rounded-2xl border border-slate-100">
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center shrink-0">
              <span class="text-primary-900 font-bold text-lg">{post.data.author.charAt(0)}</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-lg mb-1">{post.data.author}</h3>
              <p class="text-slate-500 text-sm leading-relaxed mb-3">
                Tim pengembang dan konsultan IT di Akordium Lab, membantu bisnis Indonesia berkembang melalui solusi teknologi modern.
              </p>
              <a href="/about" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-900 hover:text-accent-600 transition-colors">
                Lihat profil tim
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-12 p-6 sm:p-8 bg-[#0a142e] rounded-3xl text-white relative overflow-hidden border border-white/10 shadow-xl">
          <div class="absolute -top-12 -right-12 w-44 h-44 rounded-full bg-accent-600/20 blur-2xl pointer-events-none"></div>
          <div class="relative">
            <span class="inline-block px-3 py-1 bg-accent-500/10 border border-accent-500/25 text-accent-300 text-xs font-semibold rounded-full uppercase tracking-wider mb-3">Konsultasi Solusi</span>
            <h3 class="font-bold text-white text-xl sm:text-2xl mb-2">Tertarik mengimplementasikan sistem serupa?</h3>
            <p class="text-stone-300 text-sm mb-6 leading-relaxed max-w-xl">Tim engineer Akordium Lab siap membantu Anda merancang arsitektur dan sistem yang tepat untuk alur bisnis Anda. Konsultasi pertama 100% gratis.</p>
            <div class="flex flex-wrap gap-3">
              <a
                href={`https://wa.me/628159988995?text=${encodeURIComponent(`Halo Akordium Lab, saya membaca artikel "${post.data.titleId}" dan ingin berdiskusi lebih lanjut`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3.5 bg-accent-600 text-white font-bold rounded-xl hover:bg-accent-500 active:scale-95 transition-all shadow-md shadow-accent-600/25 text-sm"
              >
                Diskusi via WhatsApp
                <svg class="w-5 h-5 fill-white shrink-0" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </a>
              <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3.5 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl active:scale-95 transition-all text-sm border border-white/15">
                Kirim Formulir Kontak
              </a>
            </div>
          </div>
        </div>

        <!-- Related Posts -->
        {relatedPosts.length > 0 && (
          <div class="mt-20">
            <h3 class="text-2xl font-extrabold text-slate-900 mb-2">Artikel Terkait</h3>
            <p class="text-slate-500 text-sm mb-8">Artikel lain yang mungkin Anda sukai.</p>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {relatedPosts.map(related => (
                <a href={`/blog/${related.data.slug}`} class="group block">
                  <div class="bg-white rounded-2xl overflow-hidden border border-slate-100 hover:border-primary-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                    <div class="relative overflow-hidden aspect-[16/10]">
                      <img
                        src={related.data.image}
                        alt={related.data.titleId}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                      <div class="absolute top-3 left-3">
                        <span class="px-2.5 py-1 bg-primary-900 text-white text-xs font-semibold rounded-lg shadow-sm">
                          {related.data.category}
                        </span>
                      </div>
                    </div>
                    <div class="p-5">
                      <div class="flex items-center gap-2 text-sm text-slate-400 mb-2">
                        <span>{related.data.date}</span>
                        <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                        <span>{related.data.readTime}</span>
                      </div>
                      <h4 class="font-bold text-slate-900 text-base leading-snug group-hover:text-primary-900 transition-colors line-clamp-2">
                        {related.data.titleId}
                      </h4>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
