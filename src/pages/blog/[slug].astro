---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import CTA from '../../components/home/CTA.astro';

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
  }));
}

const { slug } = Astro.params;
const posts = await getCollection("blog");
const post = posts.find(p => p.data.slug === slug);

if (!post) return Astro.redirect("/blog");

const { Content } = await render(post);
const relatedPosts = posts
  .filter(p => p.data.slug !== slug)
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);
---

<Layout title={`${post.data.titleId} | Akordium Lab Blog`} description={post.data.excerptId}>
  <!-- Article Hero Header -->
  <header class="relative overflow-hidden bg-linear-to-b from-primary-50/50 via-white to-white pt-14 pb-10 border-b border-stone-100">
    <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-primary-100/50 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full bg-accent-100/30 blur-3xl pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb & Back -->
      <div class="flex items-center justify-between gap-4 mb-8">
        <a href="/blog" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-700 hover:text-primary-900 text-xs font-semibold transition-all">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Kembali ke Blog
        </a>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-primary-50 border border-primary-200/80 text-primary-900 text-xs font-semibold rounded-full uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-600 animate-pulse"></span>
          {post.data.category}
        </span>
      </div>

      <!-- Title & Subtitle -->
      <h1 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold text-stone-900 leading-tight mb-4 tracking-tight">
        {post.data.titleId}
      </h1>
      <p class="text-base sm:text-lg text-stone-500 italic mb-8 leading-relaxed">
        {post.data.title}
      </p>

      <!-- Meta Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 py-4 border-y border-stone-200/80">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-primary-900 text-white flex items-center justify-center font-bold text-sm shadow-xs">
            {post.data.author.charAt(0)}
          </div>
          <div>
            <span class="text-sm font-bold text-stone-900 block">{post.data.author}</span>
            <span class="text-[11px] text-stone-500">Engineering & Strategy Team</span>
          </div>
        </div>

        <div class="flex items-center gap-4 text-xs text-stone-500 font-medium">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            {post.data.date}
          </span>
          <span class="w-1 h-1 rounded-full bg-stone-300"></span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {post.data.readTime}
          </span>
        </div>
      </div>
    </div>
  </header>

  <!-- Article Body -->
  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Featured Image Mockup Frame -->
      <div class="mb-12">
        <div class="rounded-3xl border border-stone-200/90 overflow-hidden shadow-xl shadow-stone-200/60 bg-stone-900">
          <!-- Browser Header Bar -->
          <div class="flex items-center justify-between px-4 py-3 bg-stone-900 border-b border-stone-800 text-xs text-stone-400">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
              <span class="ml-2 font-mono text-[11px] text-stone-400">akordium.id/blog/{slug}</span>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-stone-800 text-emerald-400">article</span>
          </div>

          <!-- Cover Image with subtle gradient -->
          <div class="relative h-64 sm:h-96 lg:h-[420px] overflow-hidden">
            <img
              src={post.data.image}
              alt={post.data.titleId}
              class="w-full h-full object-cover"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a142e]/60 via-transparent to-transparent pointer-events-none"></div>
          </div>
        </div>
      </div>

      <!-- Article Content Container -->
      <div class="max-w-3xl mx-auto">
        <!-- Excerpt Callout -->
        <div class="p-6 sm:p-7 rounded-2xl bg-stone-50 border-l-4 border-accent-600 text-base sm:text-lg text-stone-800 font-medium leading-relaxed mb-10 shadow-xs">
          {post.data.excerptId}
        </div>

        <!-- Markdown Content -->
        <div class="prose prose-slate prose-lg max-w-none">
          <Content />
        </div>

        <!-- Author Bio Card -->
        <div class="mt-16 p-6 sm:p-8 bg-white rounded-3xl border border-stone-200/90 shadow-sm">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
            <div class="w-14 h-14 rounded-2xl bg-primary-900 text-white flex items-center justify-center font-bold text-xl shrink-0 shadow-md shadow-primary-950/20">
              {post.data.author.charAt(0)}
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <h3 class="font-bold text-stone-900 text-base">{post.data.author}</h3>
                <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-primary-50 text-primary-900 border border-primary-100">
                  Engineering Team
                </span>
              </div>
              <p class="text-stone-600 text-xs sm:text-sm leading-relaxed mb-3">
                Tim rekayasa perangkat lunak di Akordium Lab. Berfokus pada sistem backend tangguh (Go, PostgreSQL, TimescaleDB, Laravel), arsitektur cloud, dan otomasi proses operasional bisnis.
              </p>
              <div class="flex items-center gap-4 text-xs font-semibold">
                <a href="/about" class="text-primary-900 hover:text-accent-600 transition-colors inline-flex items-center gap-1">
                  Profil Studio Kami
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
                <a href="/services" class="text-stone-500 hover:text-primary-900 transition-colors">
                  Katalog Layanan & Solusi →
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- In-Article WhatsApp / Consultation Box -->
        <div class="mt-12 p-6 sm:p-8 bg-[#0a142e] rounded-3xl text-white relative overflow-hidden border border-white/10 shadow-xl">
          <div class="absolute -top-12 -right-12 w-44 h-44 rounded-full bg-accent-600/20 blur-2xl pointer-events-none"></div>
          <div class="relative">
            <span class="inline-block px-3 py-1 bg-accent-500/10 border border-accent-500/25 text-accent-300 text-xs font-semibold rounded-full uppercase tracking-wider mb-3">
              Konsultasi Solusi
            </span>
            <h3 class="font-bold text-white text-xl sm:text-2xl mb-2">Tertarik mengimplementasikan sistem serupa?</h3>
            <p class="text-stone-300 text-sm mb-6 leading-relaxed max-w-xl">
              Tim engineer Akordium Lab siap membantu Anda merancang arsitektur dan sistem yang tepat untuk alur bisnis Anda. Konsultasi pertama 100% gratis.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href={`https://wa.me/628159988995?text=${encodeURIComponent(`Halo Akordium Lab, saya membaca artikel "${post.data.titleId}" dan ingin berdiskusi lebih lanjut`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3.5 bg-accent-600 text-white font-bold rounded-xl hover:bg-accent-500 active:scale-95 transition-all shadow-md shadow-accent-600/25 text-sm"
              >
                Diskusi via WhatsApp
                <svg class="w-5 h-5 fill-white shrink-0" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </a>
              <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3.5 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl active:scale-95 transition-all text-sm border border-white/15">
                Kirim Formulir Kontak
              </a>
            </div>
          </div>
        </div>

        <!-- Related Posts -->
        {relatedPosts.length > 0 && (
          <div class="mt-20 pt-12 border-t border-stone-200">
            <div class="flex items-center justify-between mb-8">
              <div>
                <p class="text-xs font-bold text-accent-700 uppercase tracking-wider mb-1">Rekomendasi Terkait</p>
                <h3 class="font-sans text-2xl font-bold text-stone-900">Artikel Pilihan Lainnya</h3>
              </div>
              <a href="/blog" class="text-xs font-bold text-primary-900 hover:text-accent-600 transition-colors">
                Lihat Semua Artikel →
              </a>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {relatedPosts.map(related => (
                <a href={`/blog/${related.data.slug}`} class="group flex flex-col h-full bg-white rounded-3xl overflow-hidden border border-stone-200/80 hover:border-primary-300 hover:shadow-xl hover:shadow-primary-950/5 hover:-translate-y-1 transition-all duration-300">
                  <div class="relative overflow-hidden aspect-[16/10] bg-stone-900">
                    <img
                      src={related.data.image}
                      alt={related.data.titleId}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#0a142e]/50 via-transparent to-transparent pointer-events-none"></div>
                    <div class="absolute top-3 left-3">
                      <span class="inline-flex items-center px-2 py-0.5 bg-primary-900/90 text-white text-[10px] font-semibold rounded-full border border-white/10">
                        {related.data.category}
                      </span>
                    </div>
                  </div>
                  <div class="p-5 flex flex-col flex-1">
                    <div class="flex items-center gap-2 text-xs text-stone-400 font-medium mb-2">
                      <span>{related.data.date}</span>
                      <span class="w-1 h-1 rounded-full bg-stone-300"></span>
                      <span>{related.data.readTime}</span>
                    </div>
                    <h4 class="font-sans font-bold text-stone-900 text-sm leading-snug group-hover:text-primary-900 transition-colors line-clamp-2 mb-3 flex-1">
                      {related.data.titleId}
                    </h4>
                    <div class="flex items-center justify-end pt-3 border-t border-stone-100 text-xs font-bold text-primary-900 group-hover:text-accent-600 transition-colors">
                      Baca Artikel →
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <CTA
    eyebrow="Riset & Implementasi Sistem"
    title="Siap membangun sistem yang tepat untuk alur bisnis Anda?"
    description="Dari migrasi infrastruktur, dashboard telemetri, hingga otomasi alur kerja, kami siap membantu membangun solusi yang realistis untuk pertumbuhan bisnis Anda."
    whatsappText={`Halo tim Akordium Lab, saya membaca artikel "${post.data.titleId}" dan ingin berkonsultasi mengenai kebutuhan sistem kami`}
  />
</Layout>
