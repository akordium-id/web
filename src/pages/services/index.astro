---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';
import CTA from '../../components/home/CTA.astro';

const icons: Record<string, string> = {
  globe: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>`,
  chart: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
  cog: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
};

const serviceMeta: Record<string, { tag: string; stack: string[] }> = {
  'company-profile': {
    tag: 'Go-Live Cepat • 3 Hari',
    stack: ['Astro', 'Tailwind CSS', 'SEO Optimized', 'Responsive'],
  },
  'dashboard-web': {
    tag: 'Real-Time Telemetri & Data',
    stack: ['Laravel', 'Filament', 'PostgreSQL', 'Livewire'],
  },
  'mis-operasional': {
    tag: 'Multi-Role & Audit-Ready',
    stack: ['Go', 'PostgreSQL', 'TimescaleDB', 'Docker'],
  },
};

const servicePlaceholderImages = [
  'https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=1400&q=80',
  'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=1400&q=80',
  'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1400&q=80',
];
---

<Layout title="Layanan | Akordium Lab" description="Solusi web untuk bisnis kecil-menengah: website company profile, dashboard internal, dan management information system yang praktis.">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-linear-to-br from-white via-primary-50/50 to-accent-50/30 pt-20 pb-16 lg:pb-24 border-b border-stone-200/70">
    <!-- Ambient glows -->
    <div class="absolute -top-40 -right-40 w-120 h-120 rounded-full bg-primary-100/60 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-120 h-120 rounded-full bg-accent-100/40 blur-3xl pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #000 1px, transparent 1px); background-size: 24px 24px;"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 bg-primary-50 border border-primary-200/80 rounded-full px-4 py-1.5 mb-6 text-xs font-semibold text-primary-900 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-600 animate-pulse"></span>
        Katalog Solusi Digital
      </div>

      <h1 class="font-sans text-4xl sm:text-5xl lg:text-6xl font-extrabold text-stone-900 mb-6 leading-[1.1] tracking-tight">
        Solusi web untuk bisnis<br />
        <span class="text-accent-600">yang lebih tertata & terukur</span>
      </h1>
      <p class="text-base sm:text-lg text-stone-600 max-w-2xl mx-auto leading-relaxed">
        Kami merancang website, dashboard internal, dan sistem informasi yang praktis, terstruktur, dan mudah dipakai sehari-hari oleh seluruh tim Anda.
      </p>
    </div>
  </section>

  <!-- Services Detail -->
  <section class="py-16 lg:py-24 bg-stone-50/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      {services.map((service, i) => {
        const meta = serviceMeta[service.id];

        return (
        <div id={service.id} class="bg-white rounded-3xl border border-stone-200 p-8 lg:p-12 shadow-xs hover:border-primary-300 hover:shadow-xl hover:shadow-primary-100/30 transition-all duration-300">
          <div class={`grid lg:grid-cols-2 gap-10 lg:gap-16 items-center ${i % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
            
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <div class="flex items-center gap-3 mb-6">
                <div class="w-12 h-12 bg-primary-50 rounded-2xl flex items-center justify-center shrink-0 border border-primary-100">
                  <div class="w-6 h-6 text-primary-900" set:html={icons[service.icon]} />
                </div>
                {meta?.tag && (
                  <span class="inline-block px-3 py-1 text-xs font-bold rounded-full bg-accent-50 text-accent-700 border border-accent-200/60">
                    {meta.tag}
                  </span>
                )}
              </div>

              <h2 class="font-sans text-2xl sm:text-3xl font-extrabold text-stone-900 mb-4">{service.title}</h2>
              <p class="text-stone-600 leading-relaxed mb-6 text-sm sm:text-base">{service.description}</p>
              
              <!-- Features checklist -->
              <ul class="space-y-3 mb-8">
                {service.features.map((feat) => (
                  <li class="flex items-start gap-3">
                    <div class="w-5 h-5 bg-accent-50 rounded-full flex items-center justify-center shrink-0 mt-0.5 border border-accent-100">
                      <svg class="w-3 h-3 text-accent-600" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <span class="text-stone-700 text-sm">{feat}</span>
                  </li>
                ))}
              </ul>

              <!-- Tech Stack Badges -->
              {meta?.stack && (
                <div class="flex flex-wrap gap-1.5 mb-8 pt-4 border-t border-stone-100">
                  {meta.stack.map(tech => (
                    <span class="px-2.5 py-0.5 bg-stone-100 text-stone-700 text-xs font-medium rounded-md">
                      {tech}
                    </span>
                  ))}
                </div>
              )}

              <div class="flex items-center gap-4">
                <a href="/contact" class="btn-primary px-6 py-3 text-sm">
                  Mulai Sekarang
                  <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
                <a
                  href={`https://wa.me/628159988995?text=${encodeURIComponent(`Halo tim Akordium Lab, saya ingin konsultasi mengenai layanan ${service.title}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-900 hover:text-accent-600 transition-colors"
                >
                  Tanya via WA →
                </a>
              </div>
            </div>

            <!-- Visual Mockup Frame -->
            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              <div class="rounded-2xl border border-stone-200 overflow-hidden shadow-lg shadow-stone-200/50 bg-stone-900">
                <!-- Browser Header Bar -->
                <div class="flex items-center justify-between px-4 py-3 bg-stone-900 border-b border-stone-800 text-xs text-stone-400">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                    <span class="ml-2 font-mono text-[11px] text-stone-400">{service.id}.akordium.id</span>
                  </div>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-stone-800 text-emerald-400">active</span>
                </div>
                <!-- Image with subtle overlay -->
                <div class="relative h-64 lg:h-80 overflow-hidden">
                  <img
                    src={servicePlaceholderImages[i % servicePlaceholderImages.length]}
                    alt={`Ilustrasi untuk layanan ${service.title}`}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#0a142e]/60 via-transparent to-transparent pointer-events-none"></div>
                </div>
              </div>
            </div>

          </div>
        </div>
        );
      })}
    </div>
  </section>

  <!-- CTA Component -->
  <CTA
    eyebrow="Katalog Layanan Akordium"
    title="Siap mendigitalkan sistem bisnis Anda?"
    description="Ceritakan alur operasional bisnis Anda. Tim kami siap membantu memetakan solusi sistem yang paling terukur dan transparan."
    whatsappText="Halo Akordium Lab, saya ingin berdiskusi mengenai layanan sistem yang ada di website"
  />
</Layout>
