---
import Logo from '../../components/common/Logo.astro';
import '../../styles/global.css';

const title = 'Faiq Najib Al-Aziz | Akordium Lab';
const description =
  'Faiq Najib Al-Aziz — Founder & Technology Partner at Akordium Lab. Mitra seng peduli karo sampeyan. Web & Application, Digital Transformation, IT Consulting & Training.';
const canonical = 'https://akordium.id/card/faiq';
const ogImage = 'https://akordium.id/og-image.png';

const waMessage = encodeURIComponent(
  'Halo Faiq, saya menemukan kontak Anda dari kartu nama Akordium Lab dan ingin berdiskusi mengenai kebutuhan teknologi bisnis.',
);
const waUrl = `https://wa.me/628159988995?text=${waMessage}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Faiq Najib Al-Aziz',
  jobTitle: 'Founder & Technology Partner',
  worksFor: {
    '@type': 'Organization',
    name: 'Akordium Lab',
    url: 'https://akordium.id',
  },
  url: canonical,
  email: 'hello@akordium.id',
  telephone: '+628159988995',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Surabaya',
    addressCountry: 'ID',
  },
  sameAs: ['https://github.com/akordium-id'],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Akordium Lab" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <style>
      :root {
        --ak-navy: #122550;
        --ak-navy-dark: #0a1329;
        --ak-navy-track: #1b336a;
        --ak-orange: #f67c19;
        --ak-paper: #f6f6f4;
        --ak-paper-border: #dcdfd5;
        --ak-paper-text-dark: #122550;
        --ak-paper-text-slate: #52627a;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background-color: var(--ak-navy-dark);
        color: #e8edf5;
        font-family: 'Manrope', 'Inter', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        min-height: 100dvh;
      }

      /* Subtle ambient background glow */
      .ambient-canvas {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }

      .ambient-canvas::before {
        content: '';
        position: absolute;
        top: -10%;
        left: 50%;
        transform: translateX(-50%);
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, rgba(246, 124, 25, 0.08) 0%, rgba(18, 37, 80, 0.3) 50%, transparent 70%);
        filter: blur(80px);
      }

      /* Main container */
      .page-shell {
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px 16px 56px;
      }

      .card-wrap {
        width: 100%;
        max-width: 580px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      /* Top Bar */
      .brand-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        background: rgba(18, 37, 80, 0.6);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
      }

      .badge-connected {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.7);
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 99px;
        padding: 4px 10px;
      }

      .pulse-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--ak-orange);
        box-shadow: 0 0 8px var(--ak-orange);
      }

      /* View Mode Switcher Pills */
      .view-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 0 2px;
      }

      .view-toggle-group {
        display: inline-flex;
        background: rgba(18, 37, 80, 0.75);
        padding: 4px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .view-tab-btn {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.6);
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .view-tab-btn.is-active {
        background: var(--ak-navy);
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.15);
      }

      .flip-hint {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.5);
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 6px 8px;
        transition: color 0.2s;
      }

      .flip-hint:hover {
        color: var(--ak-orange);
      }

      .flip-hint svg {
        transition: transform 0.4s ease;
      }

      .flip-hint:hover svg {
        transform: rotate(180deg);
      }

      /* ------------------------------------------------------------- */
      /* Physical Business Card 3D Stage (90x54mm Ratio)               */
      /* ------------------------------------------------------------- */
      .card-stage {
        position: relative;
        width: 100%;
        perspective: 1200px;
      }

      .card-flipper {
        position: relative;
        width: 100%;
        aspect-ratio: 90 / 54;
        transform-style: preserve-3d;
        transition: transform 0.65s cubic-bezier(0.34, 1.35, 0.64, 1);
        cursor: pointer;
        user-select: none;
      }

      .card-flipper.is-flipped {
        transform: rotateY(180deg);
      }

      .card-face {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border-radius: clamp(14px, 3.2cqw, 20px);
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        overflow: hidden;
        box-shadow:
          0 18px 40px -8px rgba(0, 0, 0, 0.55),
          0 6px 18px -4px rgba(0, 0, 0, 0.3),
          inset 0 1px 0 rgba(255, 255, 255, 0.15);
      }

      /* ------------------------------------------------------------- */
      /* FRONT CARD (Deep Navy + Spot UV Circuit Pattern + QR)         */
      /* ------------------------------------------------------------- */
      .card-face-front {
        background-color: var(--ak-navy);
        color: #ffffff;
      }

      /* SVG canvas covers the entire card */
      .card-front-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
      }

      /* Embedded QR Module overlay */
      .qr-overlay-box {
        position: absolute;
        left: 55.5%;
        top: 22.2%;
        width: 25.5%;
        height: 42.5%;
        background: #ffffff;
        border-radius: clamp(8px, 2.2cqw, 15px);
        box-shadow:
          0 8px 24px rgba(0, 0, 0, 0.35),
          0 2px 6px rgba(0, 0, 0, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 5%;
        z-index: 5;
      }

      .qr-overlay-box canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
        border-radius: 4px;
      }

      /* ------------------------------------------------------------- */
      /* BACK CARD (Off-White Matte Paper + 2-Column Exact Layout)     */
      /* ------------------------------------------------------------- */
      .card-face-back {
        transform: rotateY(180deg);
        background-color: var(--ak-paper);
        color: var(--ak-paper-text-dark);
        border: 1px solid var(--ak-paper-border);
      }

      /* Subtle paper grain texture */
      .card-face-back::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 0);
        background-size: 6px 6px;
        opacity: 0.8;
      }

      .back-layout {
        position: relative;
        z-index: 2;
        width: 100%;
        height: 100%;
        padding: 6% 7%;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: stretch;
      }

      /* Left Column: Name, Role, 3 Pillars */
      .back-col-left {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding-right: 6%;
      }

      .back-name {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: clamp(0.95rem, 3.8cqw, 1.32rem);
        font-weight: 700;
        color: var(--ak-paper-text-dark);
        margin: 0 0 3px;
        line-height: 1.15;
        letter-spacing: -0.02em;
      }

      .back-role {
        font-family: 'Manrope', system-ui, sans-serif;
        font-size: clamp(0.65rem, 2.2cqw, 0.82rem);
        font-weight: 500;
        color: var(--ak-paper-text-slate);
        margin: 0;
        line-height: 1.3;
      }

      .back-pillars {
        display: flex;
        flex-direction: column;
        gap: clamp(4px, 1.3cqw, 8px);
        margin-top: clamp(6px, 1.8cqw, 14px);
      }

      .back-pillar-item {
        display: flex;
        align-items: center;
        gap: clamp(5px, 1.5cqw, 8px);
        font-family: 'Manrope', system-ui, sans-serif;
        font-size: clamp(0.6rem, 2.1cqw, 0.78rem);
        font-weight: 600;
        color: #2b384e;
      }

      .back-pillar-icon {
        width: clamp(14px, 3cqw, 18px);
        height: clamp(14px, 3cqw, 18px);
        color: var(--ak-paper-text-dark);
        flex-shrink: 0;
      }

      /* Divider line */
      .back-divider {
        width: 1px;
        background-color: var(--ak-paper-border);
        height: 86%;
        align-self: center;
      }

      /* Right Column: Contact info & Logo */
      .back-col-right {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding-left: 6%;
      }

      .back-contacts {
        display: flex;
        flex-direction: column;
        gap: clamp(5px, 1.6cqw, 10px);
        margin-top: 2px;
      }

      .back-contact-link {
        display: flex;
        align-items: center;
        gap: clamp(6px, 1.6cqw, 9px);
        font-family: 'Manrope', system-ui, sans-serif;
        font-size: clamp(0.62rem, 2.2cqw, 0.8rem);
        font-weight: 600;
        color: #334155;
        text-decoration: none;
      }

      .back-contact-link:hover {
        color: var(--ak-orange);
      }

      .back-contact-icon {
        width: clamp(13px, 2.8cqw, 17px);
        height: clamp(13px, 2.8cqw, 17px);
        color: var(--ak-orange);
        flex-shrink: 0;
      }

      /* Back Logo Signature (with orange strip on top) */
      .back-logo-signature {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        margin-top: auto;
      }

      .back-logo-accent {
        width: clamp(20px, 5cqw, 28px);
        height: clamp(2.5px, 0.7cqw, 3.5px);
        border-radius: 2px;
        background-color: var(--ak-orange);
        margin-bottom: 4px;
      }

      /* ------------------------------------------------------------- */
      /* Surface Panels & Action Hub                                   */
      /* ------------------------------------------------------------- */
      .surface-panel {
        background-color: #101e40;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 24px;
      }

      .panel-heading {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.4);
        margin: 0 0 16px;
      }

      .actions-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 14px 12px;
        border-radius: 12px;
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.18s ease;
        min-height: 52px;
        letter-spacing: 0.01em;
      }

      .action-btn:hover {
        transform: translateY(-2px);
      }

      .action-btn:active {
        transform: scale(0.98);
      }

      .action-btn:focus-visible {
        outline: 2px solid var(--ak-orange);
        outline-offset: 3px;
      }

      .btn-save-contact {
        background-color: #ffffff;
        color: var(--ak-navy);
        box-shadow: 0 4px 16px rgba(255, 255, 255, 0.15);
      }

      .btn-save-contact:hover {
        background-color: #f1f5f9;
        box-shadow: 0 6px 20px rgba(255, 255, 255, 0.22);
      }

      .btn-whatsapp {
        background-color: #25d366;
        color: #ffffff;
        box-shadow: 0 4px 16px rgba(37, 211, 102, 0.25);
      }

      .btn-whatsapp:hover {
        background-color: #20bd5a;
        box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
      }

      .btn-email-action {
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .btn-email-action:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
      }

      .btn-website-action {
        background: rgba(246, 124, 25, 0.12);
        color: var(--ak-orange);
        border: 1px solid rgba(246, 124, 25, 0.25);
      }

      .btn-website-action:hover {
        background: rgba(246, 124, 25, 0.22);
        border-color: rgba(246, 124, 25, 0.4);
      }

      /* Copy Info Rows */
      .info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 0;
      }

      .info-row + .info-row {
        border-top: 1px solid rgba(255, 255, 255, 0.07);
      }

      .info-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.38);
        margin-bottom: 2px;
      }

      .info-value {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.92rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.88);
        text-decoration: none;
      }

      .info-value:hover {
        color: var(--ak-orange);
      }

      .copy-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.55);
        border-radius: 8px;
        padding: 6px 12px;
        font-family: 'Manrope', system-ui, sans-serif;
        font-size: 0.74rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
        flex-shrink: 0;
        min-height: 32px;
      }

      .copy-btn:hover {
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.25);
        background: rgba(255, 255, 255, 0.1);
      }

      .copy-btn.copied {
        color: #4ade80;
        border-color: rgba(74, 222, 128, 0.35);
        background: rgba(74, 222, 128, 0.1);
      }

      /* Services List */
      .services-list {
        display: flex;
        flex-direction: column;
      }

      .service-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 0;
      }

      .service-item + .service-item {
        border-top: 1px solid rgba(255, 255, 255, 0.07);
      }

      .service-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(246, 124, 25, 0.1);
        border: 1px solid rgba(246, 124, 25, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 2px;
      }

      .service-icon svg {
        width: 18px;
        height: 18px;
        color: var(--ak-orange);
      }

      .service-title {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.92rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.92);
        margin-bottom: 3px;
        line-height: 1.3;
      }

      .service-desc {
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.5);
        line-height: 1.5;
        margin: 0;
      }

      /* Explore Links */
      .explore-links {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .explore-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 16px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.07);
        text-decoration: none;
        transition: all 0.15s ease;
        gap: 12px;
      }

      .explore-link:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.16);
        transform: translateX(2px);
      }

      .explore-link-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .explore-link-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(246, 124, 25, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .explore-link-icon svg {
        width: 16px;
        height: 16px;
        color: var(--ak-orange);
      }

      .explore-link-text {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.88rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.85);
      }

      .explore-link-sub {
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.38);
        margin-top: 1px;
      }

      .explore-link-arrow {
        color: rgba(255, 255, 255, 0.25);
        flex-shrink: 0;
      }

      /* Minimal Footer */
      .card-footer {
        text-align: center;
        padding: 8px 0 0;
      }

      .footer-brand {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
      }

      .footer-tagline {
        font-size: 0.76rem;
        color: rgba(255, 255, 255, 0.3);
        margin-top: 3px;
        font-style: italic;
      }

      .footer-meta {
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.22);
        margin-top: 8px;
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        .card-flipper {
          transition: transform 0.01ms !important;
        }
        .action-btn,
        .explore-link,
        .copy-btn {
          transition: none !important;
        }
      }
    </style>
  </head>

  <body>
    <div class="ambient-canvas" aria-hidden="true"></div>

    <main id="main-content" class="page-shell">
      <div class="card-wrap">

        <!-- ===== 1. Brand Top Bar ===== -->
        <header class="brand-top-bar" role="banner">
          <a href="https://akordium.id" aria-label="Kunjungi website Akordium Lab">
            <Logo variant="white" class="h-6 w-auto" showLab={true} />
          </a>
          <span class="badge-connected">
            <span class="pulse-dot" aria-hidden="true"></span>
            Connected Card
          </span>
        </header>

        <!-- ===== 2. View Mode Controls ===== -->
        <div class="view-controls">
          <div class="view-toggle-group" role="tablist" aria-label="Pilih sisi kartu">
            <button
              id="tab-btn-front"
              class="view-tab-btn is-active"
              role="tab"
              aria-selected="true"
              type="button"
            >
              <span>🎴</span> Sisi Depan
            </button>
            <button
              id="tab-btn-back"
              class="view-tab-btn"
              role="tab"
              aria-selected="false"
              type="button"
            >
              <span>👤</span> Sisi Belakang
            </button>
          </div>

          <button id="btn-flip-hint" class="flip-hint" type="button" aria-label="Putar kartu nama">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
            </svg>
            <span>Ketuk kartu untuk membalik</span>
          </button>
        </div>

