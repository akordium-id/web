    <!-- Client-side Scripts -->
    <script>
      // 1. Flip Card Interaction
      const flipper = document.getElementById('business-card-flipper');
      const tabFront = document.getElementById('tab-btn-front');
      const tabBack = document.getElementById('tab-btn-back');
      const btnFlipHint = document.getElementById('btn-flip-hint');

      function setCardFlipped(flipped: boolean) {
        if (!flipper) return;
        if (flipped) {
          flipper.classList.add('is-flipped');
          flipper.setAttribute('aria-pressed', 'true');
          tabBack?.classList.add('is-active');
          tabBack?.setAttribute('aria-selected', 'true');
          tabFront?.classList.remove('is-active');
          tabFront?.setAttribute('aria-selected', 'false');
        } else {
          flipper.classList.remove('is-flipped');
          flipper.setAttribute('aria-pressed', 'false');
          tabFront?.classList.add('is-active');
          tabFront?.setAttribute('aria-selected', 'true');
          tabBack?.classList.remove('is-active');
          tabBack?.setAttribute('aria-selected', 'false');
        }
      }

      function toggleFlip() {
        if (!flipper) return;
        const isFlipped = flipper.classList.contains('is-flipped');
        setCardFlipped(!isFlipped);
      }

      flipper?.addEventListener('click', (e) => {
        // Prevent flipping if user clicked directly on an anchor or interactive child
        const target = e.target as HTMLElement;
        if (target.closest('a') || target.closest('button')) return;
        toggleFlip();
      });

      flipper?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleFlip();
        }
      });

      tabFront?.addEventListener('click', () => setCardFlipped(false));
      tabBack?.addEventListener('click', () => setCardFlipped(true));
      btnFlipHint?.addEventListener('click', toggleFlip);

      // 2. vCard Generation & Download
      function downloadVCard() {
        const vcard = [
          'BEGIN:VCARD',
          'VERSION:3.0',
          'FN:Faiq Najib Al-Aziz',
          'N:Al-Aziz;Faiq Najib;;;',
          'ORG:Akordium Lab',
          'TITLE:Founder & Technology Partner',
          'TEL;TYPE=CELL,VOICE:+628159988995',
          'EMAIL;TYPE=WORK:hello@akordium.id',
          'URL:https://akordium.id',
          'ADR;TYPE=WORK:;;Surabaya;;;Indonesia',
          'NOTE:Akordium Lab - Mitra seng peduli karo sampeyan.',
          'END:VCARD',
        ].join('\r\n');

        const blob = new Blob([vcard], { type: 'text/vcard;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'Faiq-Najib-Al-Aziz.vcf';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      const saveBtn = document.getElementById('btn-save-contact');
      if (saveBtn) {
        saveBtn.addEventListener('click', downloadVCard);
      }

      // 3. Copy to Clipboard
      function attachCopyBtn(btnId: string) {
        const btn = document.getElementById(btnId) as HTMLButtonElement | null;
        if (!btn) return;
        const value = btn.dataset.copy ?? '';
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(value);
            const prev = btn.textContent;
            btn.textContent = 'Disalin!';
            btn.classList.add('copied');
            btn.setAttribute('aria-label', 'Berhasil disalin!');
            setTimeout(() => {
              btn.textContent = prev;
              btn.classList.remove('copied');
              btn.setAttribute('aria-label', btnId === 'copy-phone' ? 'Salin nomor telepon' : 'Salin alamat email');
            }, 2000);
          } catch {
            prompt('Salin:', value);
          }
        });
      }

      attachCopyBtn('copy-phone');
      attachCopyBtn('copy-email');
    </script>

    <!-- QR Code Script (Inline CDN ESM) -->
    <script type="module" is:inline>
      try {
        const QRCode = (await import('https://cdn.jsdelivr.net/npm/qrcode@1.5.4/+esm')).default;
        const canvas = document.getElementById('card-qr-canvas');
        if (canvas) {
          await QRCode.toCanvas(canvas, 'https://akordium.id/card/faiq', {
            width: 108,
            margin: 0,
            color: {
              dark: '#122550',
              light: '#ffffff',
            },
            errorCorrectionLevel: 'M',
          });
        }
      } catch (err) {
        console.warn('QR Code render fallback:', err);
      }
    </script>
  </body>
</html>
