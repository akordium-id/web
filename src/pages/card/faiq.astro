---
import Logo from '../../components/common/Logo.astro';
import '../../styles/global.css';

const title = 'Faiq Najib Al-Aziz | Akordium Lab';
const description =
  'Faiq Najib Al-Aziz — Founder & Technology Partner at Akordium Lab. Web & Application, Digital Transformation, IT Consulting & Training.';
const canonical = 'https://akordium.id/card/faiq';
const ogImage = 'https://akordium.id/og-image.png';

const waMessage = encodeURIComponent(
  'Halo Faiq, saya menemukan kontak Anda dari kartu nama Akordium Lab dan ingin berdiskusi mengenai kebutuhan teknologi bisnis.',
);
const waUrl = `https://wa.me/628159988995?text=${waMessage}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Faiq Najib Al-Aziz',
  jobTitle: 'Founder & Technology Partner',
  worksFor: {
    '@type': 'Organization',
    name: 'Akordium Lab',
    url: 'https://akordium.id',
  },
  url: canonical,
  email: 'hello@akordium.id',
  telephone: '+628159988995',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Surabaya',
    addressCountry: 'ID',
  },
  sameAs: ['https://github.com/akordium-id'],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Akordium Lab" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <style>
      :root {
        --color-card-navy: #122550;
        --color-card-navy-deep: #0a1329;
        --color-card-navy-surface: #101e40;
        --color-card-navy-track: #1c366e;
        --color-card-orange: #f67c19;
        --color-card-orange-hover: #ea6b08;
        --color-paper-bg: #f8f8f5;
        --color-paper-text-dark: #122550;
        --color-paper-text-muted: #526079;
        --color-paper-border: #e2e6ed;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background-color: var(--color-card-navy-deep);
        color: #e8edf5;
        font-family: 'Manrope', 'Inter', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        min-height: 100dvh;
      }

      /* Ambient background lighting */
      .ambient-glow {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }

      .ambient-glow::before {
        content: '';
        position: absolute;
        top: -15%;
        left: 50%;
        transform: translateX(-50%);
        width: 650px;
        height: 650px;
        background: radial-gradient(circle, rgba(246, 124, 25, 0.12) 0%, rgba(18, 37, 80, 0.25) 45%, transparent 70%);
        filter: blur(60px);
      }

      /* Layout shell */
      .page-shell {
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px 16px 48px;
      }

      .card-wrap {
        width: 100%;
        max-width: 580px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      /* Brand Header Top Bar */
      .brand-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
        background: rgba(18, 37, 80, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
      }

      .badge-connected-card {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.7);
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 99px;
        padding: 4px 10px;
      }

      .badge-pulse-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--color-card-orange);
        box-shadow: 0 0 8px var(--color-card-orange);
      }

      /* ------------------------------------------------------------- */
      /* 3D Realistic Card Stage */
      /* ------------------------------------------------------------- */
      .card-stage {
        position: relative;
        width: 100%;
        perspective: 1200px;
      }

      .card-flipper {
        position: relative;
        width: 100%;
        aspect-ratio: 90 / 54;
        transform-style: preserve-3d;
        transition: transform 0.65s cubic-bezier(0.34, 1.35, 0.64, 1);
        cursor: pointer;
        user-select: none;
      }

      .card-flipper.is-flipped {
        transform: rotateY(180deg);
      }

      .card-face {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border-radius: 20px;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        overflow: hidden;
        box-shadow:
          0 12px 36px -4px rgba(0, 0, 0, 0.45),
          0 4px 16px -2px rgba(0, 0, 0, 0.25),
          inset 0 1px 0 rgba(255, 255, 255, 0.15);
      }

      /* Subtle paper / matte finish */
      .card-face::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        border-radius: inherit;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
      }

      /* Front Face (Navy) */
      .card-face-front {
        background-color: var(--color-card-navy);
        color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 6% 7%;
      }

      .card-front-pattern {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
      }

      .front-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
      }

      .front-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
      }

      .front-bottom {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .front-tagline {
        font-family: 'Manrope', system-ui, sans-serif;
        font-size: clamp(0.7rem, 2.7cqw, 0.95rem);
        font-weight: 500;
        color: rgba(255, 255, 255, 0.85);
        line-height: 1.35;
        margin: 0;
        max-width: 55%;
      }

      .front-accent-line {
        width: clamp(28px, 8cqw, 36px);
        height: clamp(3px, 0.9cqw, 4px);
        border-radius: 2px;
        background-color: var(--color-card-orange);
      }

      /* Embedded QR Module on Front */
      .front-qr-module {
        position: absolute;
        right: 6%;
        top: 50%;
        transform: translateY(-50%);
        z-index: 3;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
      }

      .front-qr-card {
        background: #ffffff;
        padding: clamp(6px, 1.6cqw, 10px);
        border-radius: clamp(10px, 2.5cqw, 15px);
        box-shadow:
          0 8px 24px rgba(0, 0, 0, 0.35),
          0 2px 6px rgba(0, 0, 0, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .front-qr-card canvas {
        display: block;
        width: clamp(75px, 21cqw, 108px) !important;
        height: clamp(75px, 21cqw, 108px) !important;
        border-radius: 4px;
      }

      .front-qr-hint {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: clamp(8px, 1.8cqw, 9.5px);
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.6);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
      }

      /* Back Face (Warm Light Paper) */
      .card-face-back {
        transform: rotateY(180deg);
        background-color: var(--color-paper-bg);
        color: var(--color-paper-text-dark);
        padding: 5.5% 6.5%;
        display: flex;
        flex-direction: row;
        gap: 5%;
        align-items: stretch;
      }

      /* Subtle paper grain finish */
      .card-face-back::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 0);
        background-size: 8px 8px;
        opacity: 0.6;
      }

      .back-col {
        position: relative;
        z-index: 2;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .back-col-left {
        padding-right: 2%;
      }

      .back-col-divider {
        width: 1px;
        background: var(--color-paper-border);
        height: 100%;
        margin: 0;
      }

      .back-col-right {
        padding-left: 2%;
      }

      .back-name {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: clamp(0.92rem, 3.8cqw, 1.25rem);
        font-weight: 700;
        color: var(--color-paper-text-dark);
        margin: 0 0 2px;
        line-height: 1.15;
        letter-spacing: -0.02em;
      }

      .back-role {
        font-family: 'Manrope', system-ui, sans-serif;
        font-size: clamp(0.65rem, 2.3cqw, 0.82rem);
        font-weight: 600;
        color: var(--color-paper-text-muted);
        margin: 0 0 10px;
        line-height: 1.3;
      }

      .back-pillars {
        display: flex;
        flex-direction: column;
        gap: clamp(4px, 1.2cqw, 8px);
      }

      .back-pillar-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: 'Manrope', system-ui, sans-serif;
        font-size: clamp(0.62rem, 2.1cqw, 0.76rem);
        font-weight: 600;
        color: #293448;
      }

      .back-pillar-item svg {
        width: clamp(12px, 2.8cqw, 15px);
        height: clamp(12px, 2.8cqw, 15px);
        color: var(--color-card-navy);
        flex-shrink: 0;
      }

      .back-contact-list {
        display: flex;
        flex-direction: column;
        gap: clamp(5px, 1.5cqw, 9px);
        margin-top: 2px;
      }

      .back-contact-item {
        display: flex;
        align-items: center;
        gap: 7px;
        font-family: 'Manrope', system-ui, sans-serif;
        font-size: clamp(0.62rem, 2.2cqw, 0.78rem);
        font-weight: 600;
        color: #334155;
        text-decoration: none;
      }

      .back-contact-item:hover {
        color: var(--color-card-orange);
      }

      .back-contact-icon {
        width: clamp(14px, 3.2cqw, 18px);
        height: clamp(14px, 3.2cqw, 18px);
        border-radius: 4px;
        background: rgba(246, 124, 25, 0.12);
        color: var(--color-card-orange);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .back-contact-icon svg {
        width: 65%;
        height: 65%;
      }

      .back-logo-wrap {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        margin-top: auto;
      }

      .back-logo-accent {
        width: 18px;
        height: 2.5px;
        border-radius: 2px;
        background-color: var(--color-card-orange);
        margin-bottom: 4px;
      }

      /* Flip controller pills */
      .card-flip-controller {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 0 4px;
      }

      .flip-toggle-group {
        display: inline-flex;
        background: rgba(18, 37, 80, 0.65);
        padding: 4px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .flip-tab-btn {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.6);
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 5px;
      }

      .flip-tab-btn.is-active {
        background: var(--color-card-navy);
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.12);
      }

      .flip-hint-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.74rem;
        color: rgba(255, 255, 255, 0.5);
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 6px 8px;
      }

      .flip-hint-pill:hover {
        color: var(--color-card-orange);
      }

      .flip-hint-pill svg {
        transition: transform 0.4s ease;
      }

      .flip-hint-pill:hover svg {
        transform: rotate(180deg);
      }

      /* ------------------------------------------------------------- */
      /* Content Containers */
      /* ------------------------------------------------------------- */
      .surface-panel {
        background-color: var(--color-card-navy-surface);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 24px;
      }

      .panel-heading {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.4);
        margin: 0 0 16px;
      }

      /* Primary Actions Hub */
      .actions-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 14px 12px;
        border-radius: 12px;
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.18s ease;
        min-height: 52px;
        letter-spacing: 0.01em;
      }

      .action-btn:hover {
        transform: translateY(-2px);
      }

      .action-btn:active {
        transform: scale(0.98);
      }

      .action-btn:focus-visible {
        outline: 2px solid var(--color-card-orange);
        outline-offset: 3px;
      }

      .btn-save-contact {
        background-color: #ffffff;
        color: var(--color-card-navy);
        box-shadow: 0 4px 16px rgba(255, 255, 255, 0.15);
      }

      .btn-save-contact:hover {
        background-color: #f1f5f9;
        box-shadow: 0 6px 20px rgba(255, 255, 255, 0.22);
      }

      .btn-whatsapp {
        background-color: #25d366;
        color: #ffffff;
        box-shadow: 0 4px 16px rgba(37, 211, 102, 0.25);
      }

      .btn-whatsapp:hover {
        background-color: #20bd5a;
        box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
      }

      .btn-email-action {
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .btn-email-action:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
      }

      .btn-website-action {
        background: rgba(246, 124, 25, 0.12);
        color: var(--color-card-orange);
        border: 1px solid rgba(246, 124, 25, 0.25);
      }

      .btn-website-action:hover {
        background: rgba(246, 124, 25, 0.22);
        border-color: rgba(246, 124, 25, 0.4);
      }

      /* Copy Info Rows */
      .info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 0;
      }

      .info-row + .info-row {
        border-top: 1px solid rgba(255, 255, 255, 0.07);
      }

      .info-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.38);
        margin-bottom: 2px;
      }

      .info-value {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.92rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.88);
        text-decoration: none;
      }

      .info-value:hover {
        color: var(--color-card-orange);
      }

      .copy-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.55);
        border-radius: 8px;
        padding: 6px 12px;
        font-family: 'Manrope', system-ui, sans-serif;
        font-size: 0.74rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
        flex-shrink: 0;
        min-height: 32px;
      }

      .copy-btn:hover {
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.25);
        background: rgba(255, 255, 255, 0.1);
      }

      .copy-btn.copied {
        color: #4ade80;
        border-color: rgba(74, 222, 128, 0.35);
        background: rgba(74, 222, 128, 0.1);
      }

      /* Services List */
      .services-list {
        display: flex;
        flex-direction: column;
      }

      .service-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 0;
      }

      .service-item + .service-item {
        border-top: 1px solid rgba(255, 255, 255, 0.07);
      }

      .service-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(246, 124, 25, 0.1);
        border: 1px solid rgba(246, 124, 25, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 2px;
      }

      .service-icon svg {
        width: 18px;
        height: 18px;
        color: var(--color-card-orange);
      }

      .service-title {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.92rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.92);
        margin-bottom: 3px;
        line-height: 1.3;
      }

      .service-desc {
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.5);
        line-height: 1.5;
        margin: 0;
      }

      /* Explore Links */
      .explore-links {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .explore-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 16px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.07);
        text-decoration: none;
        transition: all 0.15s ease;
        gap: 12px;
      }

      .explore-link:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.16);
        transform: translateX(2px);
      }

      .explore-link-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .explore-link-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(246, 124, 25, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .explore-link-icon svg {
        width: 16px;
        height: 16px;
        color: var(--color-card-orange);
      }

      .explore-link-text {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.88rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.85);
      }

      .explore-link-sub {
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.38);
        margin-top: 1px;
      }

      .explore-link-arrow {
        color: rgba(255, 255, 255, 0.25);
        flex-shrink: 0;
      }

      /* Minimal Footer */
      .card-footer {
        text-align: center;
        padding: 8px 0 0;
      }

      .footer-brand {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
      }

      .footer-tagline {
        font-size: 0.76rem;
        color: rgba(255, 255, 255, 0.3);
        margin-top: 3px;
        font-style: italic;
      }

      .footer-meta {
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.22);
        margin-top: 8px;
      }

      /* Accessibility & Reduced Motion */
      @media (prefers-reduced-motion: reduce) {
        .card-flipper {
          transition: transform 0.01ms !important;
        }
        .action-btn,
        .explore-link,
        .copy-btn {
          transition: none !important;
        }
        .action-btn:hover,
        .explore-link:hover {
          transform: none !important;
