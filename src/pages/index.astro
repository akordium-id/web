---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import Services from '../components/home/Services.astro';
import Portfolio from '../components/home/Portfolio.astro';
import Principles from '../components/home/Principles.astro';
import Founder from '../components/home/Founder.astro';
import CTA from '../components/home/CTA.astro';
---

<Layout
  title="Akordium Lab — Boutique Software Lab & Product Studio"
  description="Kami merekayasa sistem web & backend berkinerja tinggi untuk bisnis yang menuntut keandalan. Dari arsitektur terdistribusi hingga sistem operasional presisi berbasis Go, PostgreSQL, dan Clean Architecture."
>
  <!-- 1. Hero: Positioning tegas studio & Software Showcase Window -->
  <Hero />

  <!-- 2. Proof of Reliability: Metrik throughput, uptime, dan kapasitas teruji -->
  <ProofStrip />

  <!-- 3. Core Practices: 3 Layanan rekayasa terfokus tanpa paket receh -->
  <Services />

  <!-- 4. Selected Works & Dogfooding: Showcase jendela lebar MIS-APAR, Orin GPS, Katauser -->
  <Portfolio />

  <!-- 5. Engineering Principles: Standar rekayasa, no lock-in, dan kepemilikan kode -->
  <Principles />

  <!-- 6. Founder & Studio Profile: Kredibilitas di balik Akordium Lab -->
  <Founder />

  <!-- 7. High-Intent Ingestion: Call to action konsultasi terstruktur -->
  <CTA />
</Layout>
