---
import Layout from '../layouts/Layout.astro';
import WhatsAppIcon from '../components/common/WhatsAppIcon.astro';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
---

<Layout title="Kontak | Akordium Lab" description="Hubungi tim Akordium Lab untuk konsultasi IT gratis. Kami siap membantu transformasi digital bisnis Anda.">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-linear-to-br from-white via-primary-50/50 to-accent-50/30 pt-20 pb-16 lg:pb-20 border-b border-stone-200/70">
    <!-- Ambient glows -->
    <div class="absolute -top-40 -right-40 w-120 h-120 rounded-full bg-primary-100/60 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-120 h-120 rounded-full bg-accent-100/40 blur-3xl pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #000 1px, transparent 1px); background-size: 24px 24px;"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 bg-primary-50 border border-primary-200/80 rounded-full px-4 py-1.5 mb-6 text-xs font-semibold text-primary-900 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-600 animate-pulse"></span>
        Kontak & Konsultasi
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-stone-900 mb-4 leading-tight">
        Mari Bicara<br />
        <span class="text-accent-600">Tentang Kebutuhan IT Anda</span>
      </h1>
      <p class="text-lg text-stone-600 max-w-xl mx-auto leading-relaxed">
        Konsultasi pertama 100% gratis. Tim kami siap merespons kebutuhan sistem Anda dalam 1×24 jam kerja.
      </p>
    </div>
  </section>

  <!-- Contact section -->
  <section class="py-16 lg:py-24 bg-stone-50/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-10 lg:gap-14 items-start">
        <!-- Form -->
        <div class="lg:col-span-3 bg-white rounded-3xl p-7 sm:p-10 border border-stone-200/90 shadow-sm">
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-stone-900">Kirim Pesan</h2>
            <p class="text-sm text-stone-500 mt-1">Ceritakan alur bisnis atau sistem yang ingin Anda bangun, atau tanyakan apa saja seputar layanan kami.</p>
          </div>

          <!-- Success banner, shown via JS when ?success=true -->
          <div
            id="form-success"
            class="hidden mb-6 p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-start gap-3"
            role="alert"
          >
            <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <div>
              <p class="font-bold text-emerald-900 text-sm">Pesan berhasil terkirim!</p>
              <p class="text-emerald-700 text-sm mt-0.5">Tim engineer kami akan menghubungi Anda dalam 1×24 jam kerja.</p>
            </div>
          </div>

          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-5"
          >
            <input type="hidden" name="access_key" value={accessKey} />
            <!-- redirect URL ditetapkan secara dinamis oleh script di bawah agar bekerja di semua environment -->
            <input type="hidden" id="redirect-field" name="redirect" value="" />
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-semibold text-stone-700 mb-2">Nama Lengkap <span class="text-accent-600">*</span></label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Nama Anda atau penanggung jawab"
                  class="w-full px-4 py-3 rounded-xl border border-stone-200 text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500 transition-all text-sm bg-stone-50/40 focus:bg-white"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold text-stone-700 mb-2">Email <span class="text-accent-600">*</span></label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="email@perusahaan.com"
                  class="w-full px-4 py-3 rounded-xl border border-stone-200 text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500 transition-all text-sm bg-stone-50/40 focus:bg-white"
                />
              </div>
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-stone-700 mb-2">Nomor WhatsApp / Telepon</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+62 812 3456 7890"
                class="w-full px-4 py-3 rounded-xl border border-stone-200 text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500 transition-all text-sm bg-stone-50/40 focus:bg-white"
              />
            </div>
            <div>
              <label for="service" class="block text-sm font-semibold text-stone-700 mb-2">Layanan yang Diminati</label>
              <select
                id="service"
                name="service"
                class="w-full px-4 py-3 rounded-xl border border-stone-200 text-stone-800 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500 transition-all text-sm bg-stone-50/40 focus:bg-white"
              >
                <option value="">Pilih layanan...</option>
                <option value="company-profile">Website Company Profile Cepat</option>
                <option value="dashboard-web">Dashboard Internal & Telemetri</option>
                <option value="mis-operasional">Sistem Informasi Manajemen (MIS Operasional)</option>
                <option value="other">Konsultasi / Solusi Khusus Lainnya</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-semibold text-stone-700 mb-2">Pesan & Kebutuhan Sistem <span class="text-accent-600">*</span></label>
              <textarea
                id="message"
                name="message"
                required
                rows={5}
                placeholder="Ceritakan gambaran alur bisnis, kendala operasional yang dihadapi saat ini, atau perkiraan timeline pengerjaan..."
                class="w-full px-4 py-3 rounded-xl border border-stone-200 text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500 transition-all text-sm resize-none bg-stone-50/40 focus:bg-white"
              ></textarea>
            </div>
            <!-- hCaptcha, dikelola otomatis oleh Web3Forms client script -->
            <div class="h-captcha" data-captcha="true"></div>

            <button
              type="submit"
              class="w-full py-4 bg-accent-600 text-white font-bold rounded-xl hover:bg-accent-500 active:scale-95 transition-all text-sm shadow-lg shadow-accent-600/25 cursor-pointer"
            >
              Kirim Pesan Sekarang
            </button>
            <p class="text-xs text-stone-400 text-center leading-relaxed">
              Dengan mengirim pesan ini, Anda menyetujui bahwa kami akan menghubungi Anda kembali untuk tindak lanjut konsultasi.
            </p>
          </form>
        </div>

        <!-- Info sidebar -->
        <div class="lg:col-span-2 space-y-6">
          <div>
            <h2 class="text-2xl font-bold text-stone-900">Informasi Kontak</h2>
            <p class="text-sm text-stone-500 mt-1">Kami berbasis di Surabaya dan melayani klien di seluruh Indonesia.</p>
          </div>

          <div class="space-y-3.5">
            <div class="flex items-start gap-4 p-5 bg-white rounded-2xl border border-stone-200/80 shadow-xs hover:border-primary-200 transition-colors">
              <div class="w-11 h-11 bg-primary-50 border border-primary-100/80 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-stone-900 text-sm mb-0.5">Alamat Kantor</p>
                <p class="text-stone-600 text-sm leading-relaxed">Jl. Pagesangan Agung I/84<br />Surabaya, Jawa Timur 60233</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 bg-white rounded-2xl border border-stone-200/80 shadow-xs hover:border-primary-200 transition-colors">
              <div class="w-11 h-11 bg-primary-50 border border-primary-100/80 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-stone-900 text-sm mb-0.5">Email Resmi</p>
                <a href="mailto:hello@akordium.id" class="text-primary-900 hover:text-accent-600 text-sm font-semibold transition-colors">hello@akordium.id</a>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 bg-white rounded-2xl border border-stone-200/80 shadow-xs hover:border-emerald-200 transition-colors">
              <div class="w-11 h-11 bg-emerald-50 border border-emerald-100 rounded-xl flex items-center justify-center shrink-0">
                <WhatsAppIcon class="w-5 h-5 text-emerald-600" />
              </div>
              <div>
                <p class="font-bold text-stone-900 text-sm mb-0.5">WhatsApp Langsung</p>
                <a href="https://wa.me/628159988995" target="_blank" rel="noopener noreferrer" class="text-emerald-600 hover:text-emerald-700 text-sm font-semibold">+62 815-9988-995</a>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 bg-white rounded-2xl border border-stone-200/80 shadow-xs">
              <div class="w-11 h-11 bg-primary-50 border border-primary-100/80 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-stone-900 text-sm mb-0.5">Jam Operasional</p>
                <p class="text-stone-600 text-sm leading-relaxed">Senin – Jumat: 09.00 – 17.00 WIB<br />Sabtu: 09.00 – 13.00 WIB</p>
              </div>
            </div>
          </div>

          <!-- Quick WhatsApp Card -->
          <div class="p-6 bg-[#0a142e] rounded-3xl text-white relative overflow-hidden border border-white/10 shadow-lg">
            <div class="absolute -right-10 -bottom-10 w-36 h-36 bg-accent-600/20 rounded-full blur-2xl pointer-events-none"></div>
            <p class="font-bold text-lg mb-1">Butuh Respons Cepat?</p>
            <p class="text-stone-300 text-xs sm:text-sm mb-5 leading-relaxed">Hubungi engineer kami langsung melalui WhatsApp untuk konsultasi teknis yang lebih tanggap.</p>
            <a
              href="https://wa.me/628159988995?text=Halo%20Akordium%20Lab%2C%20saya%20ingin%20konsultasi%20IT"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 bg-accent-600 text-white font-bold rounded-xl text-sm hover:bg-accent-500 transition-all shadow-md shadow-accent-600/25 active:scale-95"
            >
              <WhatsAppIcon class="w-4 h-4 text-white" />
              Chat WhatsApp Sekarang
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline src="https://web3forms.com/client/script.js" async defer></script>
<script>
  // Set redirect URL dinamis agar berfungsi di semua environment (localhost & production)
  const redirectField = document.getElementById('redirect-field') as HTMLInputElement | null;
  if (redirectField) {
    redirectField.value = window.location.origin + '/contact?success=true';
  }

  // Tampilkan banner sukses jika di-redirect balik dengan ?success=true
  if (new URLSearchParams(window.location.search).get('success') === 'true') {
    const banner = document.getElementById('form-success');
    if (banner) {
      banner.classList.remove('hidden');
      banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    // Bersihkan query string dari URL tanpa reload
    window.history.replaceState({}, '', window.location.pathname);
  }
</script>
