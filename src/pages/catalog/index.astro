---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/catalog/ProductCard.astro';
import SolutionCard from '../../components/catalog/SolutionCard.astro';
import Configurator from '../../components/catalog/Configurator.astro';
import { products, solutionPacks } from '../../data/catalog';
import WhatsAppIcon from '../../components/common/WhatsAppIcon.astro';
---

<Layout
  title="Katalog Produk & Solusi Digital Bisnis | Akordium Lab"
  description="Katalog sistem digital, modul operasional, dan website profesional dengan harga transparan dan estimasi terukur dari Akordium Lab."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-linear-to-b from-primary-50/60 via-stone-50 to-white pt-16 pb-20 lg:pt-24 lg:pb-28 border-b border-stone-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 bg-white border border-stone-200/80 rounded-full px-4 py-1.5 mb-6 text-xs font-semibold text-primary-900 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-accent-600 animate-pulse"></span>
        Transparan, Modular, dan Terukur
      </div>

      <h1 class="font-sans text-4xl sm:text-5xl lg:text-6xl font-extrabold text-stone-900 tracking-tight max-w-4xl mx-auto leading-tight">
        Solusi digital yang pas dengan <span class="text-accent-600">cara bisnis Anda</span> bekerja.
      </h1>

      <p class="mt-6 text-base sm:text-lg text-stone-600 max-w-2xl mx-auto leading-relaxed">
        Dari website profil hingga sistem operasional harian. Pilih solusi yang Anda butuhkan, pelajari cakupannya secara terbuka, dan ketahui gambaran biaya sebelum berkonsultasi.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="#ready-products" class="px-6 py-3.5 rounded-xl font-bold text-sm bg-primary-900 text-white hover:bg-primary-800 transition-all shadow-md shadow-primary-950/20 active:scale-[0.98]">
          Jelajahi Produk Siap Pakai
        </a>
        <a href="#configurator" class="px-6 py-3.5 rounded-xl font-bold text-sm bg-white text-stone-800 border border-stone-300 hover:border-stone-400 hover:bg-stone-50 transition-all active:scale-[0.98]">
          Simulasi Sistem Mandiri
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="mt-12 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs text-stone-500 font-medium">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          Harga & Scope Transparan
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          100% Kode Milik Anda
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          Tanpa Biaya Lisensi Bulanan Per User
        </span>
      </div>
    </div>
  </section>

  <!-- Ready Products Section -->
  <section id="ready-products" class="py-16 lg:py-24 bg-stone-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-accent-700 mb-2">Layer 01 — Siap Pakai</p>
          <h2 class="font-sans text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">
            Produk & Sistem Bisnis Siap Pakai
          </h2>
          <p class="text-stone-600 text-sm mt-2 max-w-xl">
            Solusi dengan ruang lingkup fitur yang sudah terdefinisi jelas sehingga Anda bisa langsung mulai tanpa keraguan biaya membengkak.
          </p>
        </div>
        <div class="mt-4 md:mt-0">
          <a href="/modules" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary-900 hover:text-accent-600 transition-colors">
            Lihat daftar modul tambahan &rarr;
          </a>
        </div>
      </div>

      <!-- Product Cards: Responsive Hybrid (Horizontal Scroll on Mobile/Tablet, Centered Grid on Desktop) -->
      <div class="relative">
        <!-- Mobile/Tablet Horizontal Scroll Track -->
        <div class="flex lg:hidden overflow-x-auto snap-x snap-mandatory gap-5 pb-6 pt-2 -mx-4 px-4 sm:-mx-6 sm:px-6 scrollbar-none">
          {products.map((product) => (
            <div class="w-[85%] sm:w-[360px] shrink-0 snap-center flex flex-col">
              <ProductCard product={product} />
            </div>
          ))}
        </div>

        <!-- Desktop Grid (3 cards top row, 2 cards bottom row centered) -->
        <div class="hidden lg:flex lg:flex-wrap lg:justify-center gap-8 items-stretch pt-2">
          {products.map((product) => (
            <div class="w-[calc(33.333%-1.35rem)] min-w-[320px] max-w-[390px] flex flex-col">
              <ProductCard product={product} />
            </div>
          ))}
        </div>

        <!-- Mobile Scroll Hint / Dots Indicator -->
        <div class="flex lg:hidden items-center justify-center gap-2 mt-2 text-stone-400 text-xs font-medium">
          <svg class="w-4 h-4 animate-pulse text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
          <span>Geser ke samping untuk melihat produk lainnya</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Solution Packs Section -->
  <section id="solution-packs" class="py-16 lg:py-24 bg-white border-t border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="text-xs font-bold uppercase tracking-wider text-accent-700 mb-2">Layer 02 — Solusi Industri</p>
        <h2 class="font-sans text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">
          Paket Alur Bisnis Berdasarkan Industri
        </h2>
        <p class="text-stone-600 text-sm sm:text-base mt-3 leading-relaxed">
          Kombinasi modul yang telah dirancang khusus untuk menuntaskan hambatan operasional di sektor toko retail, bengkel, klinik kecantikan, hingga agensi.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 items-stretch">
        {solutionPacks.map((pack) => (
          <SolutionCard solution={pack} />
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Configurator Section -->
  <section id="configurator" class="py-16 lg:py-24 bg-stone-100 border-t border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Configurator />
    </div>
  </section>

  <!-- Need Custom Quote Section -->
  <section class="py-16 lg:py-20 bg-stone-900 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8">
          <span class="inline-block px-3 py-1 bg-accent-500/20 text-accent-400 text-xs font-semibold rounded-full mb-3 border border-accent-500/30">
            Layer 03 — Custom Software Engineering
          </span>
          <h2 class="font-sans text-2xl sm:text-3xl font-extrabold text-white">
            Kebutuhan Bisnis Anda Terlalu Spesifik atau Multi-Cabang?
          </h2>
          <p class="text-stone-400 text-sm mt-3 leading-relaxed max-w-xl">
            Jika alur kerja perusahaan Anda memerlukan integrasi API khusus, modernisasi sistem database lama, atau arsitektur skala besar, tim engineering kami siap merancang arsitektur kustom dari nol.
          </p>
        </div>
        <div class="md:col-span-4 flex flex-col gap-3">
          <a
            href="https://wa.me/628159988995?text=Halo%20Akordium%20Lab,%20saya%20ingin%20konsultasi%20kebutuhan%20custom%20software%20engineering%20untuk%20perusahaan%20kami."
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl font-bold text-sm bg-accent-600 hover:bg-accent-500 text-white transition-all shadow-lg text-center"
          >
            <WhatsAppIcon class="w-5 h-5 text-white" />
            <span>Ceritakan Kebutuhan Anda</span>
          </a>
          <a
            href="/contact"
            class="py-2.5 px-4 text-center text-xs text-stone-400 hover:text-white transition-colors"
          >
            Atau kirim spesifikasi via formulir &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
