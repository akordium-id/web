---
import Logo from "./Logo.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";

const productsAndSolutions = [
  { label: "Katalog Produk & Paket", href: "/catalog" },
  { label: "Inventory Starter", href: "/catalog/inventory-starter" },
  { label: "Modular Business System", href: "/catalog/business-system-base" },
  { label: "Company Profile Starter", href: "/catalog/company-profile" },
  { label: "Modul Sistem Bisnis", href: "/modules" },
  { label: "Simulasi Konfigurator", href: "/configurator" },
  { label: "Kalkulator Urgensi Web", href: "/tools/urgensi-website" },
];

const companyAndInfo = [
  { label: "Tentang Kami", href: "/about" },
  { label: "Portofolio Proyek", href: "/#portfolio" },
  { label: "Alur Kerja", href: "/#how-it-works" },
  { label: "Blog & Insight", href: "/blog" },
  { label: "Kontak", href: "/contact" },
];

const waMessage = encodeURIComponent("Halo tim Akordium Lab, saya ingin berkonsultasi mengenai kebutuhan sistem/website untuk bisnis kami.");
---

<footer class="bg-[#0a142e] text-stone-300 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
      
      <!-- Brand & Profile (3 cols) -->
      <div class="lg:col-span-3">
        <a href="/" class="inline-flex items-center gap-2 mb-4 group" aria-label="Akordium Lab">
          <Logo variant="white" class="h-6 sm:h-7 w-auto transition-transform group-hover:scale-[1.02]" showLab={true} />
        </a>
        
        <p class="text-stone-400 text-sm leading-relaxed mb-5 max-w-sm">
          Software studio & mitra rekayasa perangkat lunak di Surabaya. Kami merancang web internal, dashboard operasional, dan sistem terstruktur yang siap scale bersama bisnis Anda.
        </p>

        <!-- Tech Stack Badges -->
        <div class="mb-6">
          <span class="text-[11px] font-semibold text-stone-500 uppercase tracking-wider block mb-2">Core Tech Stack</span>
          <div class="flex flex-wrap gap-1.5">
            <span class="px-2.5 py-1 bg-white/5 text-xs font-medium text-stone-300 rounded-md border border-white/10">Go</span>
            <span class="px-2.5 py-1 bg-white/5 text-xs font-medium text-stone-300 rounded-md border border-white/10">PostgreSQL</span>
            <span class="px-2.5 py-1 bg-white/5 text-xs font-medium text-stone-300 rounded-md border border-white/10">Laravel</span>
            <span class="px-2.5 py-1 bg-white/5 text-xs font-medium text-stone-300 rounded-md border border-white/10">Docker</span>
          </div>
        </div>

        <!-- Social & Contact Icons -->
        <div class="flex items-center gap-2.5">
          <a
            href="https://instagram.com/akordium.id"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram @akordium.id"
            class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-stone-400 hover:text-white hover:bg-white/10 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href={`https://wa.me/628159988995?text=${waMessage}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp Akordium"
            class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 hover:bg-emerald-500/20 transition-colors"
          >
            <WhatsAppIcon class="w-4 h-4" />
          </a>
          <a
            href="mailto:halo@akordium.id"
            aria-label="Email Akordium"
            class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-stone-400 hover:text-white hover:bg-white/10 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Produk & Solusi (4 cols) -->
      <div class="lg:col-span-4">
        <h3 class="text-white font-semibold text-sm mb-4 tracking-tight">Produk & Solusi</h3>
        <ul class="space-y-2.5">
          {productsAndSolutions.map(p => (
            <li>
              <a href={p.href} class="text-sm text-stone-400 hover:text-white transition-colors inline-flex items-center gap-1.5 group">
                <span class="w-1 h-1 rounded-full bg-stone-600 group-hover:bg-accent-400 transition-colors"></span>
                {p.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Perusahaan (2 cols) -->
      <div class="lg:col-span-2">
        <h3 class="text-white font-semibold text-sm mb-4 tracking-tight">Perusahaan</h3>
        <ul class="space-y-2.5">
          {companyAndInfo.map(i => (
            <li>
              <a href={i.href} class="text-sm text-stone-400 hover:text-white transition-colors inline-flex items-center gap-1.5 group">
                <span class="w-1 h-1 rounded-full bg-stone-600 group-hover:bg-accent-400 transition-colors"></span>
                {i.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Office & Direct Consultation (3 cols) -->
      <div class="lg:col-span-3">
        <h3 class="text-white font-semibold text-sm mb-4 tracking-tight">Konsultasi Cepat</h3>
        <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-3">
          <div class="flex items-start gap-2.5 text-xs text-stone-300">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Respons via WhatsApp &lt;24 jam pada hari kerja.</span>
          </div>
          <div class="flex items-start gap-2.5 text-xs text-stone-300">
            <svg class="w-4 h-4 text-accent-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Surabaya, Jawa Timur, Indonesia.</span>
          </div>
          <a
            href={`https://wa.me/628159988995?text=${waMessage}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 w-full px-4 py-2.5 bg-accent-600 hover:bg-accent-500 text-white text-xs font-semibold rounded-lg transition-all shadow-sm active:scale-[0.98]"
          >
            <span>Chat via WhatsApp</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-stone-500 text-center sm:text-left">
        <p>© {new Date().getFullYear()} Akordium Lab. Seluruh hak cipta dilindungi.</p>
        <span class="hidden sm:inline text-stone-700">&bull;</span>
        <p>Solusi Digital & Rekayasa Perangkat Lunak Indonesia 🇮🇩</p>
      </div>
      
      <!-- Operational Liveness Indicator -->
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-stone-400">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-medium text-[11px]">Sistem operasional & siap proyek baru</span>
      </div>
    </div>
  </div>
</footer>
