---
import Logo from "./Logo.astro";

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";

const navLinks = [
  { href: isHome ? "#services" : "/#services", label: "Layanan" },
  { href: isHome ? "#works" : "/#works", label: "Portofolio" },
  { href: isHome ? "#pricing" : "/#pricing", label: "Paket & Biaya" },
  { href: isHome ? "#modules" : "/#modules", label: "Modul" },
  { href: isHome ? "#principles" : "/#principles", label: "Prinsip Rekayasa" },
  { href: isHome ? "#about" : "/#about", label: "Profil Founder" },
  { href: "/blog", label: "Catatan Teknis" },
];
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50">
  <!-- Main nav -->
  <div data-main-nav class="bg-white/90 backdrop-blur-xl border-b border-stone-200/80 shadow-2xs transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center justify-between h-16">
        <!-- Logo -->
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-1.5 group py-1" aria-label="Akordium Lab">
            <Logo variant="navy" class="h-6 sm:h-7 w-auto transition-transform group-hover:scale-[1.02]" showLab={true} />
          </a>
        </div>

        <!-- Desktop Nav -->
        <ul class="hidden lg:flex items-center gap-1">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="px-3.5 py-2 rounded-lg text-xs font-semibold text-stone-700 hover:text-primary-900 hover:bg-primary-50 transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <!-- CTA Action -->
        <div class="hidden lg:flex items-center gap-3">
          <a
            href={isHome ? "#contact" : "/contact"}
            class="px-4 py-2 bg-accent-600 hover:bg-accent-700 text-white text-xs font-bold rounded-lg active:scale-95 transition-all shadow-sm hover:shadow-md hover:shadow-accent-500/20"
          >
            Diskusi Proyek &rarr;
          </a>
        </div>

        <!-- Mobile Hamburger -->
        <button id="menu-toggle" class="lg:hidden p-2 rounded-lg text-stone-600 hover:text-stone-900 hover:bg-stone-100 transition-colors" aria-label="Toggle menu" aria-expanded="false">
          <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </nav>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-stone-200 bg-white shadow-xl">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2 rounded-lg text-sm font-semibold text-stone-700 hover:text-stone-900 hover:bg-stone-50 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3 border-t border-stone-100 mt-3">
        <a
          href={isHome ? "#contact" : "/contact"}
          class="block w-full text-center px-4 py-2.5 bg-accent-600 hover:bg-accent-700 text-white text-xs font-bold rounded-lg transition-colors shadow-sm"
        >
          Diskusi Proyek &rarr;
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function syncMainPadding() {
    const header = document.getElementById('main-header');
    const main = document.getElementById('main-content');
    if (header && main) {
      (main as HTMLElement).style.paddingTop = header.offsetHeight + 'px';
    }
  }

  // Mobile menu toggle
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    toggle?.setAttribute('aria-expanded', String(!isOpen));
  });

  // Smooth scroll handler for mobile menu clicks
  const mobileLinks = menu?.querySelectorAll('a');
  mobileLinks?.forEach((a) => {
    a.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // Elevated scroll state
  const mainNav = document.querySelector('[data-main-nav]') as HTMLElement;
  window.addEventListener('scroll', () => {
    if (mainNav) {
      if (window.scrollY > 10) {
        mainNav.classList.remove('bg-white/90', 'border-stone-200/80', 'shadow-2xs');
        mainNav.classList.add('bg-white', 'border-stone-300', 'shadow-sm');
      } else {
        mainNav.classList.remove('bg-white', 'border-stone-300', 'shadow-sm');
        mainNav.classList.add('bg-white/90', 'border-stone-200/80', 'shadow-2xs');
      }
    }
  });

  syncMainPadding();
  window.addEventListener('resize', syncMainPadding);
</script>
