---
import type { ModuleItem } from '../../data/catalog';

interface Props {
  module: ModuleItem;
}

const { module } = Astro.props;
---

<div class="bg-white rounded-2xl border border-stone-200 p-6 flex flex-col h-full hover:border-primary-300 hover:shadow-md transition-all">
  <div class="flex items-start justify-between gap-3 mb-3">
    <span class="inline-block text-[11px] font-semibold text-primary-800 bg-primary-50 px-2.5 py-1 rounded-md border border-primary-100/60">
      {module.categoryLabel}
    </span>
    <span class="font-sans font-bold text-sm text-stone-900 bg-stone-100 px-2.5 py-1 rounded-md">
      + {module.priceFormatted}
    </span>
  </div>

  <h3 class="font-sans font-bold text-lg text-stone-900 mb-2">
    {module.name}
  </h3>

  <p class="text-xs text-stone-600 leading-relaxed mb-4">
    {module.description}
  </p>

  <!-- Problem & Business Impact -->
  <div class="bg-amber-50/60 border border-amber-200/50 rounded-xl p-3 mb-5">
    <p class="text-[10px] font-bold text-amber-900 uppercase tracking-wider mb-1 flex items-center gap-1">
      <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      Dampak Langsung ke Bisnis:
    </p>
    <p class="text-xs text-amber-950 font-medium">
      {module.businessImpact}
    </p>
  </div>

  <!-- Capabilities list -->
  <div class="mt-auto">
    <p class="text-[11px] font-bold text-stone-500 uppercase tracking-wider mb-2">Cakupan Fitur:</p>
    <ul class="space-y-1.5">
      {module.features.map((feat) => (
        <li class="flex items-center gap-2 text-xs text-stone-600">
          <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span>{feat}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
