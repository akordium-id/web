---
import type { Product } from '../../data/catalog';
import WhatsAppIcon from '../common/WhatsAppIcon.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Akordium Lab, saya tertarik mengetahui detail dan kesesuaian produk "${product.name}" (${product.priceFormatted}) untuk bisnis saya.`
);
const waUrl = `https://wa.me/628159988995?text=${waMessage}`;
---

<div class={`relative bg-white rounded-2xl border transition-all duration-300 flex flex-col h-full ${
  product.popular
    ? 'border-primary-600 shadow-xl shadow-primary-950/10 ring-1 ring-primary-600'
    : 'border-stone-200 hover:border-primary-300 hover:shadow-lg hover:shadow-stone-200/50'
}`}>
  <!-- Badges -->
  {product.badge && (
    <div class="absolute -top-3 left-6">
      <span class={`inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full shadow-sm ${
        product.popular
          ? 'bg-primary-900 text-white'
          : 'bg-emerald-600 text-white'
      }`}>
        {product.badge}
      </span>
    </div>
  )}

  <div class="p-6 sm:p-7 flex flex-col flex-1">
    <!-- Category & Title -->
    <div class="mb-4 pt-1">
      <span class="text-[11px] font-semibold text-primary-800 uppercase tracking-wider">
        {product.categoryLabel}
      </span>
      <h3 class="font-sans font-bold text-xl sm:text-2xl text-stone-900 mt-1">
        {product.name}
      </h3>
      <p class="text-xs sm:text-sm text-stone-600 mt-2 leading-relaxed">
        {product.shortDescription}
      </p>
    </div>

    <!-- Pricing Area -->
    <div class="py-4 my-2 border-y border-stone-100">
      <div class="flex items-baseline gap-1.5 flex-wrap">
        <span class="font-sans text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight">
          {product.priceFormatted}
        </span>
      </div>
      {product.priceSubtext && (
        <p class="text-[11px] text-stone-500 mt-1 font-medium">
          {product.priceSubtext}
        </p>
      )}
      <div class="flex items-center gap-2 mt-2.5 text-xs text-stone-600">
        <svg class="w-4 h-4 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Estimasi pengerjaan: <strong>{product.estimatedDuration}</strong></span>
      </div>
    </div>

    <!-- Feature Highlights -->
    <div class="my-4 flex-1">
      <p class="text-xs font-bold uppercase tracking-wider text-stone-700 mb-3">Termasuk di dalamnya:</p>
      <ul class="space-y-2.5">
        {product.keyHighlights.slice(0, 4).map((highlight) => (
          <li class="flex items-start gap-2.5 text-xs sm:text-sm text-stone-700">
            <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>{highlight}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Suitable for -->
    <div class="bg-stone-50 rounded-xl p-3.5 mb-6 border border-stone-100">
      <p class="text-[11px] font-bold text-stone-500 uppercase tracking-wider mb-1.5">Cocok untuk:</p>
      <div class="flex flex-wrap gap-1.5">
        {product.targetAudience.map((aud) => (
          <span class="inline-block text-[11px] bg-white border border-stone-200/80 rounded-md px-2 py-0.5 text-stone-700 font-medium">
            {aud}
          </span>
        ))}
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="grid grid-cols-2 gap-2 mt-auto pt-2">
      <a
        href={`/catalog/${product.slug}`}
        class="flex items-center justify-center py-2.5 px-3 rounded-xl font-semibold text-xs text-stone-700 bg-stone-100 hover:bg-stone-200 transition-colors text-center"
      >
        Lihat Detail
      </a>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={`flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl font-semibold text-xs text-white transition-all text-center ${
          product.popular
            ? 'bg-primary-900 hover:bg-primary-800 shadow-md shadow-primary-900/20'
            : 'bg-emerald-600 hover:bg-emerald-700 shadow-sm'
        }`}
      >
        <WhatsAppIcon class="w-4 h-4 shrink-0 text-white" />
        <span>Konsultasi</span>
      </a>
    </div>
  </div>
</div>
