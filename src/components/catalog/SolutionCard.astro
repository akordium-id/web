---
import type { SolutionPack } from '../../data/catalog';
import { modules } from '../../data/catalog';
import WhatsAppIcon from '../common/WhatsAppIcon.astro';

interface Props {
  solution: SolutionPack;
}

const { solution } = Astro.props;

const solutionModules = modules.filter(m => solution.recommendedModules.includes(m.id));
const waMessage = encodeURIComponent(
  `Halo Akordium Lab, saya tertarik mendiskusikan "${solution.title}" untuk kebutuhan bisnis ${solution.sector}. Mohon info estimasi dan alur kerjanya.`
);
const waUrl = `https://wa.me/628159988995?text=${waMessage}`;
---

<div class="bg-white rounded-2xl border border-stone-200 hover:border-primary-300 p-6 sm:p-7 flex flex-col h-full hover:shadow-lg transition-all">
  <div class="mb-4">
    <span class="inline-block text-[11px] font-semibold text-accent-700 bg-accent-50 px-2.5 py-0.5 rounded-full border border-accent-200/50 uppercase tracking-wider mb-2">
      {solution.sector}
    </span>
    <h3 class="font-sans font-bold text-xl text-stone-900">
      {solution.title}
    </h3>
    <p class="text-xs sm:text-sm text-stone-600 mt-2 leading-relaxed">
      {solution.description}
    </p>
  </div>

  <!-- Pain points -->
  <div class="bg-stone-50 rounded-xl p-3.5 mb-5 border border-stone-100">
    <p class="text-[11px] font-bold text-stone-500 uppercase tracking-wider mb-2">Masalah Umum yang Dituntaskan:</p>
    <ul class="space-y-1.5">
      {solution.painPoints.map((pain) => (
        <li class="flex items-start gap-2 text-xs text-stone-700">
          <svg class="w-3.5 h-3.5 text-rose-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <span>{pain}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Included modules -->
  <div class="mb-6 flex-1">
    <p class="text-xs font-bold uppercase tracking-wider text-stone-700 mb-2.5">Kombinasi Modul Rekomendasi:</p>
    <div class="flex flex-wrap gap-1.5">
      {solutionModules.map((m) => (
        <span class="inline-flex items-center gap-1 text-xs bg-primary-50/70 border border-primary-100 text-primary-900 rounded-lg px-2.5 py-1 font-medium">
          <svg class="w-3 h-3 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          {m.name}
        </span>
      ))}
    </div>
  </div>

  <!-- Pricing summary & Action -->
  <div class="pt-4 border-t border-stone-100 mt-auto">
    <div class="flex items-baseline justify-between gap-2 mb-4">
      <div>
        <span class="text-[10px] text-stone-500 block uppercase font-bold tracking-wider">Perkiraan Investasi</span>
        <span class="font-sans font-extrabold text-lg sm:text-xl text-stone-900">{solution.estimatedPriceRange}</span>
      </div>
      <div class="text-right">
        <span class="text-[10px] text-stone-500 block uppercase font-bold tracking-wider">Waktu Selesai</span>
        <span class="text-xs font-semibold text-stone-700">{solution.estimatedDuration}</span>
      </div>
    </div>

    <a
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl font-semibold text-xs sm:text-sm bg-primary-900 text-white hover:bg-primary-800 transition-colors shadow-sm"
    >
      <WhatsAppIcon class="w-4 h-4 text-emerald-400" />
      <span>Diskusikan Alur Bisnis Ini</span>
    </a>
  </div>
</div>
