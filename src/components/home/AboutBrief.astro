---
const valuePillars = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />`,
    color: "text-primary-700",
    bg: "bg-primary-50",
    label: "Delivery Terstruktur & Transparan",
    desc: "Proses jelas dari awal hingga sistem go-live. Tidak ada tebak-tebakan; Anda akan mendapatkan laporan progres rutin setiap minggu agar semua tetap sesuai rencana.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />`,
    color: "text-primary-800",
    bg: "bg-primary-100/50",
    label: "Dibangun Khusus (Tailor-Made)",
    desc: "Bukan template generik. Kami merancang sistem yang mengikuti workflow unik bisnis Anda, bukan bisnis Anda yang dipaksa mengikuti sistem.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
    color: "text-primary-700",
    bg: "bg-primary-50",
    label: "Dampak Langsung ke Operasional",
    desc: "Lebih dari sekadar website, ini adalah alat kerja. Fokus kami adalah menghemat waktu tim Anda dan membereskan kekacauan (chaos) administratif secara permanen.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
    color: "text-primary-800",
    bg: "bg-primary-100/50",
    label: "Teknologi Tepat Guna",
    desc: "Kami memilih tech stack yang sudah teruji dan mudah dirawat, bukan sekadar mengikuti tren. Setiap keputusan teknis diambil demi stabilitas bisnis Anda dalam jangka panjang.",
  },
];
---

<section class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Left: Value proposition -->
      <div>
        <p class="eyebrow text-xs mb-3">Kenapa Akordium Lab</p>
        <h2 class="font-sans text-3xl sm:text-4xl lg:text-[44px] font-extrabold text-stone-900 leading-snug mb-6">
          Sistem yang <span class="text-accent-600">membantu kerja,</span><br class="hidden sm:block" />
          bukan sekadar jadi pajangan.
        </h2>
        <p class="text-base text-stone-600 leading-relaxed mb-8 max-w-lg">
          Kami tidak ingin Anda merasa seperti membeli kucing dalam karung. Proses kami dirancang transparan agar Anda tahu persis apa yang sedang dibangun dan bagaimana sistem itu akan membantu Anda nantinya.
        </p>
        <a href="/catalog" class="inline-flex items-center gap-2 px-6 py-3.5 bg-accent-600 text-white text-sm font-semibold rounded-xl hover:bg-accent-700 active:scale-95 transition-all shadow-sm shadow-accent-500/20">
          Lihat katalog solusi
          <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Right: Value pillar cards -->
      <div class="space-y-4">
        {valuePillars.map((p) => (
          <div class="flex items-start gap-4 p-5 rounded-2xl border border-stone-200 bg-white hover:border-primary-200 hover:shadow-md hover:shadow-primary-100/30 transition-all">
            <div class={`w-10 h-10 ${p.bg} rounded-xl flex items-center justify-center shrink-0`}>
              <svg class={`w-5 h-5 ${p.color}`} aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <Fragment set:html={p.icon} />
              </svg>
            </div>
            <div>
              <p class="font-sans text-sm font-bold text-stone-900 mb-1">{p.label}</p>
              <p class="text-sm text-stone-600 leading-relaxed">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>
