---
---

<section class="relative bg-linear-to-b from-primary-50/60 via-white to-stone-50/40 pt-28 pb-16 lg:pt-36 lg:pb-24 border-b border-stone-200/80 overflow-hidden">
  <!-- Subtle technical grid background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#e1ebfa_1px,transparent_1px),linear-gradient(to_bottom,#e1ebfa_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-40 pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <!-- Left Column: Studio Pitch (7 cols on lg) -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Studio Identity Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono font-semibold text-primary-900 bg-primary-50 border border-primary-200/80 shadow-2xs">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-600 animate-pulse"></span>
          Mitra Rekayasa Perangkat Lunak · Surabaya & Remote
        </div>

        <!-- Main Headline -->
        <h1 class="font-sans text-4xl sm:text-5xl lg:text-[54px] font-extrabold text-stone-900 leading-[1.08] tracking-tight">
          Dari proses manual ke sistem digital yang <span class="text-accent-600">terstruktur</span>.
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-stone-600 leading-relaxed max-w-2xl">
          Akordium membantu bisnis menghemat waktu, mencegah selisih stok, dan merapikan operasional. Dibangun cepat, <strong class="text-primary-950 font-semibold">100% hak milik Anda</strong>, tanpa biaya langganan bulanan per-user.
        </p>

        <!-- CTAs with signature Akordium Vibrant Orange and Navy -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
          <a
            href="#contact"
            class="btn-primary gap-2.5 px-7 py-3.5 text-sm shadow-lg shadow-accent-500/20 hover:shadow-xl hover:shadow-accent-500/30 active:scale-[0.98]"
          >
            <span>Jadwalkan Konsultasi Teknis</span>
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#works"
            class="btn-secondary gap-2 px-7 py-3.5 text-sm group"
          >
            <svg class="w-4 h-4 text-stone-500 group-hover:text-primary-900 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <span>Eksplor Portofolio</span>
          </a>
        </div>

        <!-- Trust Signals Checklist -->
        <div class="pt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-stone-700 font-medium">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            100% Kode & Database Milik Anda
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Selesai Cepat (3–7 Hari Kerja)
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Diskusi Langsung dengan Engineer
          </span>
        </div>
      </div>

      <!-- Right Column: Business Operations Dashboard Showcase (5 cols on lg) -->
      <div class="lg:col-span-5">
        <div class="window-frame-dark shadow-2xl shadow-primary-950/20">
          <!-- Window Title Bar -->
          <div class="flex items-center justify-between px-4 py-3 bg-primary-900 border-b border-primary-800">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
              <span class="ml-2 font-mono text-[11px] text-primary-200">app.akordium.id</span>
            </div>
            <div class="flex items-center gap-1.5 text-[11px] font-mono text-emerald-400 bg-emerald-950/80 border border-emerald-800/80 px-2.5 py-0.5 rounded">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Sistem Operasional Aktif</span>
            </div>
          </div>

          <!-- Window Body: Business Operational Dashboard UI -->
          <div class="p-5 space-y-4 bg-primary-950 text-white">
            
            <!-- Quick Business Stats Cards -->
            <div class="grid grid-cols-3 gap-2.5">
              <div class="p-3 rounded-xl bg-primary-900/90 border border-primary-800/80">
                <div class="text-[10px] font-mono text-primary-300 uppercase">Omset Hari Ini</div>
                <div class="text-sm sm:text-base font-extrabold text-white mt-0.5 font-sans">Rp 14,8jt</div>
                <div class="text-[10px] text-emerald-400 font-mono mt-0.5 font-semibold">↑ 14.2% vs kemarin</div>
              </div>
              <div class="p-3 rounded-xl bg-primary-900/90 border border-primary-800/80">
                <div class="text-[10px] font-mono text-primary-300 uppercase">Akurasi Stok</div>
                <div class="text-sm sm:text-base font-extrabold text-emerald-400 mt-0.5 font-sans">99.8%</div>
                <div class="text-[10px] text-primary-300 font-mono mt-0.5">0 selisih fisik</div>
              </div>
              <div class="p-3 rounded-xl bg-primary-900/90 border border-primary-800/80">
                <div class="text-[10px] font-mono text-primary-300 uppercase">Status Invoice</div>
                <div class="text-sm sm:text-base font-extrabold text-white mt-0.5 font-sans">18 Lunas</div>
                <div class="text-[10px] text-accent-400 font-mono mt-0.5 font-semibold">Tercatat rapi</div>
              </div>
            </div>

            <!-- Live Automated Activity Feed -->
            <div class="space-y-2">
              <div class="text-[10px] uppercase font-mono font-bold tracking-wider text-primary-300 pb-1 border-b border-primary-800 flex justify-between items-center">
                <span>Alur Kerja Otomatis (Live)</span>
                <span class="text-emerald-400 font-semibold font-mono text-[10px]">Real-time</span>
              </div>

              <!-- Activity 1: Stock Inflow -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-primary-900/90 border border-primary-800/80">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-lg bg-emerald-950 border border-emerald-800/80 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                  </div>
                  <div>
                    <div class="font-sans font-semibold text-xs text-primary-100">Stok Masuk: 120 Unit Produk</div>
                    <div class="text-[10px] font-mono text-primary-300">Admin Gudang · Otomatis update aset</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-emerald-400 font-semibold bg-emerald-950/80 px-2 py-0.5 rounded border border-emerald-800/60">Tersimpan</span>
              </div>

              <!-- Activity 2: Automated Invoice -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-primary-900/90 border border-primary-800/80">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-lg bg-primary-800 border border-primary-700/80 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  </div>
                  <div>
                    <div class="font-sans font-semibold text-xs text-primary-100">Invoice #INV-2841 Terbit</div>
                    <div class="text-[10px] font-mono text-primary-300">Notifikasi PDF WhatsApp terkirim ke pelanggan</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-accent-400 font-semibold bg-accent-950/60 px-2 py-0.5 rounded border border-accent-800/60">Terkirim</span>
              </div>

              <!-- Activity 3: Stock Warning Alert -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-primary-900/90 border border-primary-800/80">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-lg bg-amber-950 border border-amber-800/80 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                  </div>
                  <div>
                    <div class="font-sans font-semibold text-xs text-primary-100">Peringatan: Stok SKU-402 Menipis</div>
                    <div class="text-[10px] font-mono text-primary-300">Tersisa 3 unit di bawah batas aman gudang</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-amber-400 font-semibold bg-amber-950/80 px-2 py-0.5 rounded border border-amber-800/60">Peringatan</span>
              </div>
            </div>

            <!-- Bottom Handover Strip -->
            <div class="p-3 bg-primary-900/60 rounded-xl border border-primary-800/80 flex items-center justify-between text-[11px] font-mono">
              <div class="flex items-center gap-2 text-primary-200">
                <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>Tanpa Spreadsheet Berceceran</span>
              </div>
              <span class="text-emerald-400 font-semibold">100% Hak Milik Klien</span>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
