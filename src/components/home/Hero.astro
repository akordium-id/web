---
---

<section class="relative bg-linear-to-b from-primary-50/60 via-white to-stone-50/40 pt-28 pb-16 lg:pt-36 lg:pb-24 border-b border-stone-200/80 overflow-hidden">
  <!-- Subtle technical grid background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#e1ebfa_1px,transparent_1px),linear-gradient(to_bottom,#e1ebfa_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-40 pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <!-- Left Column: Studio Pitch (7 cols on lg) -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Studio Identity Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono font-semibold text-primary-900 bg-primary-50 border border-primary-200/80 shadow-2xs">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-600 animate-pulse"></span>
          Mitra Rekayasa Perangkat Lunak · Surabaya & Remote
        </div>

        <!-- Main Headline -->
        <h1 class="font-sans text-4xl sm:text-5xl lg:text-[54px] font-extrabold text-stone-900 leading-[1.08] tracking-tight">
          Dari proses manual ke sistem digital yang <span class="text-accent-600">terstruktur</span>.
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-stone-600 leading-relaxed max-w-2xl">
          Akordium membantu bisnis menghemat waktu, mencegah selisih stok, dan merapikan operasional. Dibangun cepat, <strong class="text-primary-950 font-semibold">100% hak milik Anda</strong>, tanpa biaya langganan bulanan per-user.
        </p>

        <!-- CTAs with signature Akordium Vibrant Orange and Navy -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
          <a
            href="#contact"
            class="btn-primary gap-2.5 px-7 py-3.5 text-sm shadow-lg shadow-accent-500/20 hover:shadow-xl hover:shadow-accent-500/30 active:scale-[0.98]"
          >
            <span>Jadwalkan Konsultasi Teknis</span>
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#works"
            class="btn-secondary gap-2 px-7 py-3.5 text-sm group"
          >
            <svg class="w-4 h-4 text-stone-500 group-hover:text-primary-900 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <span>Eksplor Portofolio</span>
          </a>
        </div>

        <!-- Trust Signals Checklist -->
        <div class="pt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-stone-700 font-medium">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            100% Kode & Database Milik Anda
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Selesai Cepat (3–7 Hari Kerja)
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Diskusi Langsung dengan Engineer
          </span>
        </div>
      </div>

      <!-- Right Column: Authentic macOS-Style Showcase in Akordium Deep Navy (5 cols on lg) -->
      <div class="lg:col-span-5">
        <div class="window-frame-dark shadow-2xl shadow-primary-950/20">
          <!-- Window Title Bar -->
          <div class="flex items-center justify-between px-4 py-3 bg-primary-900 border-b border-primary-800">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
              <span class="ml-2 font-mono text-[11px] text-primary-200">cluster-01.akordium.id</span>
            </div>
            <div class="flex items-center gap-1.5 text-[11px] font-mono text-emerald-400 bg-emerald-950/80 border border-emerald-800/80 px-2 py-0.5 rounded">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>All Systems Nominal</span>
            </div>
          </div>

          <!-- Window Body: Real Architectural Metrics in Deep Navy Canvas -->
          <div class="p-5 space-y-4 font-mono text-xs bg-primary-950">
            <!-- Active Subsystems Grid -->
            <div class="space-y-2">
              <div class="text-[10px] uppercase font-bold tracking-wider text-primary-300 pb-1 border-b border-primary-800 flex justify-between">
                <span>Active Core Services</span>
                <span>Latency</span>
              </div>

              <!-- Service 1: API Gateway -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-primary-900/90 border border-primary-800/80">
                <div class="flex items-center gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <div>
                    <div class="font-semibold text-primary-100">api-gateway:v3</div>
                    <div class="text-[10px] text-primary-300">Go Fiber · REST & Webhook</div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-emerald-400 font-bold">12ms</div>
                  <div class="text-[10px] text-primary-300">p99: 45ms</div>
                </div>
              </div>

              <!-- Service 2: Telemetry Ingest -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-primary-900/90 border border-primary-800/80">
                <div class="flex items-center gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <div>
                    <div class="font-semibold text-primary-100">telemetry-ingest</div>
                    <div class="text-[10px] text-primary-300">TimescaleDB · 10k stream/s</div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-emerald-400 font-bold">0.8ms</div>
                  <div class="text-[10px] text-primary-300">0 dropped</div>
                </div>
              </div>

              <!-- Service 3: Dogfood Client Portal -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-primary-900/90 border border-primary-800/80">
                <div class="flex items-center gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <div>
                    <div class="font-semibold text-primary-100">katauser-portal</div>
                    <div class="text-[10px] text-primary-300">Livewire + Flux UI · Token auth</div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-accent-400 font-bold">Ready</div>
                  <div class="text-[10px] text-primary-300">Active dogfood</div>
                </div>
              </div>
            </div>

            <!-- Terminal Stream Bar -->
            <div class="p-3 bg-primary-900/70 rounded-lg border border-primary-800 text-[11px] text-primary-200 space-y-1">
              <div class="text-[10px] text-primary-300 uppercase tracking-wider font-semibold">Live Traffic Preview</div>
              <div class="text-primary-100 truncate"><span class="text-emerald-400 font-bold">POST</span> /api/v1/telemetry/packet <span class="text-primary-300">[200 OK] 14ms</span></div>
              <div class="text-primary-100 truncate"><span class="text-accent-400 font-bold">GET</span> /b/client-board/review <span class="text-primary-300">[200 OK] 28ms</span></div>
              <div class="text-primary-300 flex items-center justify-between pt-1 border-t border-primary-800 text-[10px]">
                <span>Postgres Pool: 18/50 active</span>
                <span class="text-emerald-400">SSL / TLS 1.3</span>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
