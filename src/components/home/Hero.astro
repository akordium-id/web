---
---

<section class="relative overflow-hidden bg-linear-to-br from-white via-primary-50/50 to-accent-50/30 pt-20 pb-0">
  <!-- Background decorations -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-40 -right-40 w-150 h-150 rounded-full bg-primary-100/60 blur-3xl"></div>
    <div class="absolute top-1/2 -left-40 w-100 h-100 rounded-full bg-accent-100/40 blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-center py-20 lg:py-28">

      <!-- Left: Copy -->
      <div>
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-primary-50 border border-primary-200/80 rounded-full px-5 py-2 mb-10 text-xs font-semibold text-primary-900">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-600 animate-pulse"></span>
          Solusi digital untuk bisnis Indonesia
        </div>

        <h1 class="font-sans text-5xl sm:text-6xl lg:text-[72px] font-bold text-stone-900 leading-[1.05] tracking-tight">
          Operasional lebih tertata, <span class="text-accent-600">bisnis tumbuh</span> lebih cepat.
        </h1>
        <p class="mt-8 text-lg sm:text-xl text-stone-600 leading-relaxed max-w-xl">
          Dari proses manual ke sistem digital yang terstruktur. Akordium membantu bisnis kecil-menengah menghemat waktu, mengurangi kesalahan, dan mengambil keputusan lebih cepat dengan data yang akurat.
        </p>

        <div class="mt-12 flex flex-col sm:flex-row items-start sm:items-center gap-5">
          <a href="/contact" class="btn-primary gap-2.5 px-8 py-4 text-base shadow-lg shadow-accent-200 hover:shadow-xl hover:shadow-accent-500/20 active:scale-[0.98]">
            Hubungi Kami
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/services" class="btn-secondary gap-2 px-8 py-4 text-base group">
            <svg class="w-4 h-4 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            Lihat Layanan Kami
          </a>
        </div>

        <!-- Trust Signals Pill -->
        <div class="mt-8 flex flex-wrap items-center gap-y-2.5 gap-x-6 text-xs text-stone-600 font-medium">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Respon dalam &lt; 24 jam
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            7+ Instansi Aktif
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Konsultasi Gratis Tanpa Komitmen
          </span>
        </div>

      </div>

      <!-- Right: UI Mockup Cards on light background -->
      <div class="relative flex items-center justify-center min-h-[460px] sm:min-h-[500px]">

        <!-- Shadow base plate with browser-like frame -->
        <div class="w-full max-w-[480px] bg-white rounded-2xl shadow-2xl border border-stone-200/80 overflow-hidden">
          <!-- Window Header -->
          <div class="flex items-center justify-between px-4 py-3 bg-stone-100/70 border-b border-stone-200 text-xs text-stone-500">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-stone-300"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-stone-300"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-stone-300"></span>
              <span class="ml-2 font-mono text-[11px] text-stone-500">ops.akordium.id</span>
            </div>
            <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-2.5 py-0.5 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Live Sync
            </span>
          </div>

          <!-- Window Body -->
          <div class="p-5 space-y-4">
            <!-- Stat counters -->
            <div class="grid grid-cols-3 gap-2.5">
              <div class="bg-stone-50 border border-stone-100 rounded-xl p-3">
                <p class="text-[10px] uppercase font-bold text-stone-400">Order Bulan Ini</p>
                <p class="text-lg font-bold text-stone-900 mt-1">384</p>
                <p class="text-[10px] text-emerald-600 font-semibold mt-0.5">↑ 14.2%</p>
              </div>
              <div class="bg-primary-50/70 border border-primary-100 rounded-xl p-3">
                <p class="text-[10px] uppercase font-bold text-primary-700">Akurasi Stok</p>
                <p class="text-lg font-bold text-primary-900 mt-1">99.8%</p>
                <p class="text-[10px] text-primary-700 font-medium mt-0.5">0 selisih fisik</p>
              </div>
              <div class="bg-stone-50 border border-stone-100 rounded-xl p-3">
                <p class="text-[10px] uppercase font-bold text-stone-400">Latensi Sistem</p>
                <p class="text-lg font-bold text-stone-900 mt-1">0.4s</p>
                <p class="text-[10px] text-emerald-600 font-semibold mt-0.5">Go + Postgres</p>
              </div>
            </div>

            <!-- Operations Activity Log -->
            <div class="border border-stone-100 rounded-xl p-3.5 bg-white space-y-2.5">
              <div class="flex items-center justify-between text-[11px]">
                <span class="font-bold text-stone-800">Alur Kerja Real-Time</span>
                <span class="text-stone-400 font-mono text-[10px]">auto-sync</span>
              </div>
              <div class="space-y-2">
                <div class="flex items-center justify-between text-xs p-2 rounded-lg bg-stone-50/80">
                  <div class="flex items-center gap-2.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                    <div>
                      <p class="font-medium text-stone-800 text-[11px]">Inspeksi Aset Gudang B</p>
                      <p class="text-[10px] text-stone-400">Barcode verified · no delay</p>
                    </div>
                  </div>
                  <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">Selesai</span>
                </div>
                <div class="flex items-center justify-between text-xs p-2 rounded-lg bg-stone-50/80">
                  <div class="flex items-center gap-2.5">
                    <span class="w-2 h-2 rounded-full bg-primary-600 shrink-0"></span>
                    <div>
                      <p class="font-medium text-stone-800 text-[11px]">Surat Jalan & Invoice #2841</p>
                      <p class="text-[10px] text-stone-400">Sinkron ke divisi keuangan</p>
                    </div>
                  </div>
                  <span class="text-[10px] font-semibold text-primary-700 bg-primary-50 px-2 py-0.5 rounded">Terkirim</span>
                </div>
                <div class="flex items-center justify-between text-xs p-2 rounded-lg bg-stone-50/80">
                  <div class="flex items-center gap-2.5">
                    <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
                    <div>
                      <p class="font-medium text-stone-800 text-[11px]">10.420 GPS Telemetri Unit</p>
                      <p class="text-[10px] text-stone-400">Throughput stabil tanpa bottleneck</p>
                    </div>
                  </div>
                  <span class="text-[10px] font-semibold text-amber-800 bg-amber-50 px-2 py-0.5 rounded">99.9% Up</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating micro-card: quick metric -->
        <div class="hidden sm:flex surface-card absolute -bottom-4 -left-6 p-3.5 items-center gap-3 shadow-xl border border-stone-200">
          <div class="w-9 h-9 rounded-xl bg-primary-100 flex items-center justify-center text-primary-700 shrink-0 font-bold text-sm">
            4×
          </div>
          <div>
            <p class="text-xs font-bold text-stone-900">Efisiensi Koordinasi</p>
            <p class="text-[11px] text-stone-500">Tanpa spreadsheet berceceran</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom divider into next section -->
    <div class="relative">
      <div class="h-20 bg-linear-to-b from-transparent to-stone-50"></div>
    </div>
  </div>
</section>
