---
const metrics = [
  {
    value: "10.000+",
    label: "Perangkat IoT Aktif",
    subtext: "Streaming telemetri armada real-time",
  },
  {
    value: "99.9%",
    label: "Target Uptime",
    subtext: "Infrastruktur kritis tanpa downtime",
  },
  {
    value: "< 100ms",
    label: "Endpoint Latency",
    subtext: "Arsitektur Go & query teroptimasi",
  },
  {
    value: "100%",
    label: "Code Ownership",
    subtext: "Hak cipta penuh & repo milik Anda",
  },
];
---

<section class="bg-primary-50/30 border-b border-primary-100/80 py-10 lg:py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 divide-y sm:divide-y-0 sm:divide-x divide-primary-100/80">
      {metrics.map((metric, idx) => (
        <div class={`flex flex-col justify-center ${idx !== 0 ? 'pt-4 sm:pt-0 sm:pl-6 lg:pl-8' : ''}`}>
          <div class="font-mono text-2xl sm:text-3xl lg:text-4xl font-extrabold text-primary-950 tracking-tight">
            {metric.value}
          </div>
          <div class="text-xs sm:text-sm font-bold text-stone-900 mt-1">
            {metric.label}
          </div>
          <div class="text-[11px] sm:text-xs text-stone-600 mt-0.5 leading-snug">
            {metric.subtext}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
