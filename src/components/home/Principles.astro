---
const principles = [
  {
    number: "01",
    title: "100% Hak Cipta & Infra Milik Anda",
    description:
      "Seluruh kode sumber, skrip migrasi database, dan manifest deployment adalah aset milik perusahaan Anda seutuhnya. Tanpa ikatan sewa lisensi tahunan atau jebakan vendor lock-in.",
    tag: "No Vendor Lock-In",
  },
  {
    number: "02",
    title: "Dirancang untuk Mudah Dirawat",
    description:
      "Kami menerapkan Clean Architecture yang konsisten dan teruji. Struktur folder, pemisahan dependensi, dan dokumentasi disusun rapi agar tim internal Anda mudah meneruskannya di kemudian hari.",
    tag: "Maintainable Code",
  },
  {
    number: "03",
    title: "Komunikasi Langsung dengan Engineer",
    description:
      "Hilangkan bias komunikasi dari project manager non-teknis. Diskusi strategi arsitektur dan pemecahan masalah dilakukan langsung bersama software engineer yang bertanggung jawab atas kode Anda.",
    tag: "Direct Collaboration",
  },
  {
    number: "04",
    title: "Milestone Nyata & Terukur",
    description:
      "Kami bekerja dalam siklus rilis terencana dengan demo aplikasi langsung di staging environment. Anda selalu mengetahui persis progres teknis dan alokasi waktu tanpa janji mengambang.",
    tag: "Demo-Driven Sprints",
  },
];
---

<section id="principles" class="py-20 lg:py-28 bg-stone-50 border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono font-semibold text-primary-900 bg-primary-50 border border-primary-200/80 mb-4 shadow-2xs">
        Engineering Philosophy
      </div>
      <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold text-stone-900 tracking-tight leading-tight">
        Standar & Etika Rekayasa Kami
      </h2>
      <p class="mt-4 text-base sm:text-lg text-stone-600 leading-relaxed">
        Kami menjunjung tinggi integritas craftsmanship software. Tanpa kode artifisial tanpa arah, tanpa arsitektur misterius, dan selalu berorientasi pada nilai bisnis jangka panjang.
      </p>
    </div>

    <!-- 4 Principles Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {principles.map((p) => (
        <div class="bg-white rounded-2xl border border-primary-100 p-6 sm:p-7 flex flex-col justify-between hover:border-primary-400 hover:shadow-lg hover:shadow-primary-100/40 transition-all duration-200">
          <div>
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-primary-50">
              <span class="font-mono text-2xl font-extrabold text-primary-300">
                {p.number}
              </span>
              <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-primary-50 text-primary-800 border border-primary-100">
                {p.tag}
              </span>
            </div>
            <h3 class="font-sans text-base sm:text-lg font-bold text-stone-900 tracking-tight mb-2.5 leading-snug">
              {p.title}
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              {p.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
