---
const principles = [
  {
    number: "01",
    title: "100% Hak Milik Anda",
    description:
      "Kode sumber dan database diserahkan penuh. Bebas biaya sewa bulanan dan tanpa jebakan vendor lock-in.",
    tag: "No Vendor Lock-In",
  },
  {
    number: "02",
    title: "Mudah Dirawat & Dikembangkan",
    description:
      "Ditulis dengan arsitektur bersih dan terstruktur rapi agar mudah dipelajari serta diteruskan tim internal Anda.",
    tag: "Clean Architecture",
  },
  {
    number: "03",
    title: "Diskusi Langsung dengan Engineer",
    description:
      "Tanpa perantara sales atau PM non-teknis. Solusi dan arsitektur dibahas langsung bersama pembuat sistemnya.",
    tag: "Direct Collaboration",
  },
  {
    number: "04",
    title: "Progres Nyata & Terukur",
    description:
      "Kami bekerja bertahap dengan demo aplikasi berkala. Anda selalu tahu persis apa yang sedang dibangun tanpa tebak-tebakan.",
    tag: "Milestone-Driven",
  },
];
---

<section id="principles" class="py-20 lg:py-28 bg-stone-50 border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono font-semibold text-primary-900 bg-primary-50 border border-primary-200/80 mb-4 shadow-2xs">
        Prinsip Kerja Kami
      </div>
      <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold text-stone-900 tracking-tight leading-tight">
        Komitmen Kami untuk Bisnis Anda
      </h2>
      <p class="mt-4 text-base sm:text-lg text-stone-600 leading-relaxed">
        Kami bekerja dengan jujur, disiplin teknis yang jelas, dan selalu berorientasi pada kemudahan operasional jangka panjang.
      </p>
    </div>

    <!-- 4 Principles Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {principles.map((p) => (
        <div class="bg-white rounded-2xl border border-primary-100 p-6 sm:p-7 flex flex-col justify-between hover:border-primary-400 hover:shadow-lg hover:shadow-primary-100/40 transition-all duration-200">
          <div>
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-primary-50">
              <span class="font-mono text-2xl font-extrabold text-primary-300">
                {p.number}
              </span>
              <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-primary-50 text-primary-800 border border-primary-100">
                {p.tag}
              </span>
            </div>
            <h3 class="font-sans text-base sm:text-lg font-bold text-stone-900 tracking-tight mb-2.5 leading-snug">
              {p.title}
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              {p.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
