---
const principles = [
  {
    title: "100% Hak Milik Anda",
    description:
      "Kode sumber dan database diserahkan penuh. Bebas biaya sewa bulanan dan tanpa jebakan vendor lock-in.",
    tag: "No Vendor Lock-In",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" /></svg>`,
  },
  {
    title: "Mudah Dirawat & Dikembangkan",
    description:
      "Ditulis dengan arsitektur bersih dan terstruktur rapi agar mudah dipelajari serta diteruskan tim internal Anda.",
    tag: "Clean Architecture",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
  },
  {
    title: "Diskusi Langsung dengan Engineer",
    description:
      "Tanpa perantara sales atau PM non-teknis. Solusi dan arsitektur dibahas langsung bersama pembuat sistemnya.",
    tag: "Direct Collaboration",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`,
  },
  {
    title: "Progres Nyata & Terukur",
    description:
      "Kami bekerja bertahap dengan demo aplikasi berkala. Anda selalu tahu persis apa yang sedang dibangun tanpa tebak-tebakan.",
    tag: "Milestone-Driven",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" /></svg>`,
  },
];
---

<section id="principles" class="py-20 lg:py-28 bg-stone-50 border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono font-semibold text-primary-900 bg-primary-50 border border-primary-200/80 mb-4 shadow-2xs">
        Prinsip Kerja Kami
      </div>
      <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold text-stone-900 tracking-tight leading-tight">
        Komitmen Kami <br class="hidden sm:inline" />untuk Bisnis Anda
      </h2>
      <p class="mt-4 text-base sm:text-lg text-stone-600 leading-relaxed">
        Kami bekerja dengan jujur, disiplin teknis yang jelas, dan selalu berorientasi pada kemudahan operasional jangka panjang.
      </p>
    </div>

    <!-- 4 Principles Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {principles.map((p) => (
        <div class="bg-white rounded-2xl border border-primary-100 p-6 sm:p-7 flex flex-col justify-between hover:border-primary-400 hover:shadow-lg hover:shadow-primary-100/40 transition-all duration-200">
          <div>
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-primary-50">
              <div class="w-9 h-9 rounded-lg bg-primary-50 border border-primary-200/80 flex items-center justify-center shrink-0" set:html={p.icon}>
              </div>
              <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-primary-50 text-primary-800 border border-primary-100">
                {p.tag}
              </span>
            </div>
            <h3 class="font-sans text-base sm:text-lg font-bold text-stone-900 tracking-tight mb-2.5 leading-snug">
              {p.title}
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              {p.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
