---
const clients = [
  {
    name: "Bank Mega",
    tag: "Banking & Finance",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />`,
  },
  {
    name: "Orin GPS",
    tag: "IoT & Fleet Platform",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />`,
  },
  {
    name: "Teavaro",
    tag: "F&B / Retail Brand",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />`,
  },
  {
    name: "CV Andika Jaya",
    tag: "Distributor & Logistik",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-2m-4-1v8m0 0l3-3m-3 3L9 8m-5 5h2.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293h3.172a1 1 0 00.707-.293l2.414-2.414a1 1 0 01.707-.293H20" />`,
  },
  {
    name: "Sabagya.co",
    tag: "Commercial Creative",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />`,
  },
];

const impactMetrics = [
  { value: "4×", label: "Peningkatan Throughput", sub: "Bank Mega transaction automation" },
  { value: "10k+", label: "Perangkat IoT Aktif", sub: "Orin GPS real-time telemetry" },
  { value: "0.4s", label: "Response Time Stabil", sub: "MIS-APAR operasional (dari 4.2s)" },
  { value: "3 Hari", label: "Serah Terima Cepat", sub: "Company Profile siap go-live" },
];
---

<section class="py-14 bg-stone-50 border-y border-stone-200/70">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Client Trust Strip -->
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 pb-10 border-b border-stone-200/80">
      <div class="text-center lg:text-left shrink-0">
        <p class="eyebrow text-xs mb-1.5">Klien & Portofolio</p>
        <h3 class="font-sans text-xl sm:text-2xl font-bold text-stone-900">
          Dipercaya oleh bisnis & instansi yang serius
        </h3>
      </div>

      <!-- Badges -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        {clients.map((client) => (
          <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-white border border-stone-200 shadow-xs hover:border-primary-200 hover:shadow-sm transition-all duration-200">
            <span class="w-7 h-7 rounded-lg bg-primary-50 text-primary-700 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <Fragment set:html={client.icon} />
              </svg>
            </span>
            <div class="text-left">
              <p class="font-sans font-bold text-xs sm:text-sm text-stone-900 tracking-tight leading-none">{client.name}</p>
              <p class="text-[10px] text-stone-600 leading-none mt-1">{client.tag}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Quick Impact Metrics Strip -->
    <div class="pt-8 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      {impactMetrics.map((item) => (
        <div class="space-y-1">
          <p class="font-sans text-3xl sm:text-4xl font-extrabold text-primary-700 tracking-tight">{item.value}</p>
          <p class="text-xs sm:text-sm font-bold text-stone-800">{item.label}</p>
          <p class="text-[11px] text-stone-600 hidden sm:block">{item.sub}</p>
        </div>
      ))}
    </div>
    
  </div>
</section>