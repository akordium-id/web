---
import WhatsAppIcon from "../common/WhatsAppIcon.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  whatsappText?: string;
}

const {
  eyebrow = "Mulai dari satu titik",
  title = "Punya proses bisnis yang terasa makin berat & berulang?",
  description = "Mari rapikan dari alur yang paling kritikal dulu. Konsultasi pertama 100% gratis, tanpa komitmen.",
  whatsappText = "Halo Akordium Lab, saya ingin konsultasi kebutuhan sistem",
} = Astro.props;

const waUrl = `https://wa.me/628159988995?text=${encodeURIComponent(whatsappText)}`;
---

<section class="py-24 relative overflow-hidden bg-[#0a142e]">
  <!-- Background decoration -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-primary-600/25 blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-accent-600/20 blur-3xl"></div>
    <!-- Subtle dot grid -->
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-xs font-semibold text-accent-400 uppercase tracking-widest mb-4">{eyebrow}</p>

    <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-6 leading-tight">
      {title}
    </h2>
    <p class="text-stone-300 text-base sm:text-lg mb-10 max-w-xl mx-auto leading-relaxed">
      {description}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-accent-600 hover:bg-accent-500 text-white font-bold rounded-xl active:scale-95 transition-all shadow-xl shadow-accent-600/20 text-sm w-full sm:w-auto"
      >
        <WhatsAppIcon class="w-5 h-5 fill-white shrink-0" />
        Konsultasi via WhatsApp
      </a>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl active:scale-95 transition-all text-sm w-full sm:w-auto border border-white/15"
      >
        Kirim Formulir Kontak
        <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <!-- Trust signals -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-stone-300 text-xs sm:text-sm">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        Tanpa biaya awal
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        Respon dalam &lt; 24 jam
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        7+ instansi aktif
      </span>
    </div>
  </div>
</section>
