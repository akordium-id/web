---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  whatsappText?: string;
}

const {
  eyebrow = "Mulai dari satu titik",
  title = "Punya proses bisnis yang terasa makin berat & berulang?",
  description = "Mari rapikan dari alur yang paling kritikal dulu. Konsultasi pertama 100% gratis, tanpa komitmen.",
  whatsappText = "Halo Akordium Lab, saya ingin konsultasi kebutuhan sistem",
} = Astro.props;

const waUrl = `https://wa.me/628159988995?text=${encodeURIComponent(whatsappText)}`;
---

<section class="py-24 relative overflow-hidden bg-[#0a142e]">
  <!-- Background decoration -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-primary-600/25 blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-accent-600/20 blur-3xl"></div>
    <!-- Subtle dot grid -->
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-xs font-semibold text-accent-400 uppercase tracking-widest mb-4">{eyebrow}</p>

    <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-6 leading-tight">
      {title}
    </h2>
    <p class="text-stone-300 text-base sm:text-lg mb-10 max-w-xl mx-auto leading-relaxed">
      {description}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-accent-600 hover:bg-accent-500 text-white font-bold rounded-xl active:scale-95 transition-all shadow-xl shadow-accent-600/20 text-sm w-full sm:w-auto"
      >
        <svg class="w-5 h-5 fill-white shrink-0" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Konsultasi via WhatsApp
      </a>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl active:scale-95 transition-all text-sm w-full sm:w-auto border border-white/15"
      >
        Kirim Formulir Kontak
        <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <!-- Trust signals -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-stone-300 text-xs sm:text-sm">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        Tanpa biaya awal
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        Respon dalam &lt; 24 jam
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        7+ instansi aktif
      </span>
    </div>
  </div>
</section>
