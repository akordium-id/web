---
import { pricingTiers } from '../../data/pricing';

const waLinks: Record<string, string> = {
  'company-profile': 'https://wa.me/628159988995?text=Halo%20Akordium%20Lab,%20saya%20tertarik%20dengan%20paket%20Company%20Profile%20(Rp%20500rb)',
  'dashboard': 'https://wa.me/628159988995?text=Halo%20Akordium%20Lab,%20saya%20ingin%20konsultasi%20paket%20Dashboard%20%26%20Sistem%20Internal',
  'mis': 'https://wa.me/628159988995?text=Halo%20Akordium%20Lab,%20saya%20ingin%20diskusi%20kebutuhan%20MIS%20Operasional%20Custom',
};
---

<section id="pricing" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <p class="eyebrow text-xs mb-3">Pilihan Paket & Investasi</p>
      <h2 class="font-sans text-3xl sm:text-4xl lg:text-[44px] font-extrabold text-stone-900 leading-tight mb-4">
        Transparan, Sesuai Kebutuhan & Skala Bisnis
      </h2>
      <p class="text-stone-600 text-base max-w-2xl mx-auto leading-relaxed">
        Pilih paket yang paling tepat untuk fase bisnis Anda saat ini. Dari kehadiran digital awal hingga sistem operasional custom tanpa biaya tersembunyi.
      </p>
    </div>

    <!-- 3-Column Comparative Grid -->
    <div class="grid md:grid-cols-3 gap-8 items-stretch pt-4">
      {pricingTiers.map((tier) => {
        const isPopular = tier.id === 'dashboard';
        const waHref = waLinks[tier.id] || 'https://wa.me/628159988995';

        return (
          <div
            class={`relative rounded-2xl flex flex-col transition-all duration-300 ${
              isPopular
                ? 'bg-stone-900 text-white border-2 border-accent-500 shadow-2xl shadow-primary-950/30 md:-translate-y-2.5 p-8'
                : 'bg-white text-stone-900 border border-stone-200 hover:border-primary-300 hover:shadow-xl hover:shadow-primary-100/40 p-8'
            }`}
          >
            <!-- Highlight Badge -->
            {isPopular && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-accent-600 text-white text-[11px] font-bold uppercase tracking-wider px-4 py-1 rounded-full shadow-md">
                Paling Diminati
              </div>
            )}

            <div class="mb-6">
              <div class="flex items-center justify-between gap-2 mb-2">
                <h3 class={`font-sans font-bold text-xl ${isPopular ? 'text-white' : 'text-stone-900'}`}>
                  {tier.nameId}
                </h3>
                {tier.badgeId && !isPopular && (
                  <span class="inline-block px-2.5 py-0.5 text-[11px] font-semibold rounded-full bg-primary-50 text-primary-900 border border-primary-100">
                    {tier.badgeId}
                  </span>
                )}
              </div>
              <p class={`text-xs leading-relaxed ${isPopular ? 'text-stone-300' : 'text-stone-500'}`}>
                {tier.descriptionId}
              </p>
            </div>

            <!-- Price -->
            <div class={`pb-6 mb-6 border-b ${isPopular ? 'border-stone-800' : 'border-stone-100'}`}>
              <div class="flex items-baseline gap-1">
                <span class={`font-sans text-3xl sm:text-4xl font-extrabold tracking-tight ${isPopular ? 'text-white' : 'text-stone-900'}`}>
                  {tier.price}
                </span>
                {tier.period && (
                  <span class={`text-xs ${isPopular ? 'text-stone-400' : 'text-stone-500'}`}>
                    {tier.period}
                  </span>
                )}
              </div>
            </div>

            <!-- Features -->
            <ul class="space-y-3.5 mb-8 flex-1">
              {tier.features.map((feat) => (
                <li class={`flex items-start gap-3 text-xs sm:text-sm ${
                  feat.included
                    ? isPopular ? 'text-stone-200' : 'text-stone-700'
                    : isPopular ? 'text-stone-500 line-through' : 'text-stone-400 line-through'
                }`}>
                  {feat.included ? (
                    <svg class={`w-4 h-4 shrink-0 mt-0.5 ${isPopular ? 'text-accent-400' : 'text-accent-600'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                  ) : (
                    <svg class="w-4 h-4 shrink-0 mt-0.5 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  )}
                  <span>{feat.textId}</span>
                </li>
              ))}
            </ul>

            <!-- CTA Actions -->
            <div class="space-y-2.5 mt-auto pt-4">
              <a
                href={waHref}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-full flex items-center justify-center gap-2.5 py-3.5 px-4 rounded-xl font-bold text-sm transition-all group ${
                  isPopular
                    ? 'bg-accent-600 text-white hover:bg-accent-500 shadow-lg shadow-accent-600/30 active:scale-[0.98]'
                    : 'bg-primary-900 text-white hover:bg-primary-800 active:scale-[0.98]'
                }`}
              >
                <svg
                  class={`w-5 h-5 shrink-0 transition-transform group-hover:scale-110 ${isPopular ? 'text-white' : 'text-[#25D366]'}`}
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                <span>{tier.ctaTextId}</span>
              </a>
              <a
                href="/contact"
                class={`block text-center text-xs transition-colors py-1 ${
                  isPopular ? 'text-stone-400 hover:text-white' : 'text-stone-500 hover:text-stone-900'
                }`}
              >
                Atau kirim detail via formulir &rarr;
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Reassurance / Trust Guarantees -->
    <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-stone-50 border border-stone-200/80">
      <div class="grid sm:grid-cols-3 gap-6 text-center sm:text-left">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-3">
          <span class="w-9 h-9 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </span>
          <div>
            <p class="font-sans font-bold text-sm text-stone-900">Pembayaran Bertahap</p>
            <p class="text-xs text-stone-600 mt-0.5">Sistem termin sesuai progress milestone pengerjaan.</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-3">
          <span class="w-9 h-9 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </span>
          <div>
            <p class="font-sans font-bold text-sm text-stone-900">Garansi & Bebas Bug</p>
            <p class="text-xs text-stone-600 mt-0.5">Pendampingan dan perbaikan bug setelah sistem go-live.</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-3">
          <span class="w-9 h-9 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </span>
          <div>
            <p class="font-sans font-bold text-sm text-stone-900">Kode & Data Milik Anda</p>
            <p class="text-xs text-stone-600 mt-0.5">100% full handover ke server atau infrastruktur Anda.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>