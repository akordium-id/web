---
---

<section id="how-it-works" class="py-20 lg:py-28 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16">
      <p class="eyebrow text-xs mb-3">Alur Kerja</p>
      <h2 class="font-sans text-3xl sm:text-4xl lg:text-[44px] font-extrabold text-stone-900 leading-tight mb-4">
        Empat Langkah Menuju Sistem yang Mandiri
      </h2>
      <p class="text-stone-600 max-w-xl mx-auto leading-relaxed">
        Dari eksplorasi awal hingga serah terima penuh, setiap tahapan dirancang terbuka, terprediksi, dan minim risiko untuk bisnis Anda.
      </p>
    </div>

    <!-- Steps -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 relative">

      {[
        {
          step: "01",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />`,
          title: "Pilih Kebutuhan",
          desc: "Temukan produk atau modul yang relevan lewat katalog atau kalkulator simulasi. Anda sudah punya gambaran biaya sejak hari pertama.",
          color: "bg-primary-800",
        },
        {
          step: "02",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />`,
          title: "Validasi Workflow",
          desc: "Sesi diskusi singkat gratis untuk memastikan fitur tepat sasaran dan memotong kompleksitas yang tidak dibutuhkan tim Anda.",
          color: "bg-primary-900",
        },
        {
          step: "03",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />`,
          title: "Bangun & Konfigurasi",
          desc: "Akordium mengonfigurasi modul, menguji performa, dan memastikan sistem siap dipakai dengan standar keamanan teruji.",
          color: "bg-accent-700",
        },
        {
          step: "04",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />`,
          title: "Gunakan & Kembangkan",
          desc: "Deploy ke infrastruktur Anda. 100% data dan kode milik Anda. Siap ditambah modul baru kapan saja bisnis Anda bertumbuh.",
          color: "bg-emerald-700",
        },
      ].map((item) => (
        <div class="relative z-10 bg-white rounded-2xl border border-stone-200 p-6 sm:p-7 shadow-xs hover:border-primary-300 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <!-- Step number + icon -->
            <div class="flex items-center justify-between gap-4 mb-5">
              <div class={`w-11 h-11 ${item.color} rounded-xl flex items-center justify-center shrink-0 shadow-sm text-white`}>
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <Fragment set:html={item.icon} />
                </svg>
              </div>
              <span class="font-sans text-3xl font-extrabold text-stone-300 leading-none">{item.step}</span>
            </div>

            <!-- Content -->
            <h3 class="font-sans font-bold text-stone-900 text-base sm:text-lg mb-2">{item.title}</h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-12 text-center">
      <a href="/catalog" class="inline-flex items-center gap-2 text-sm font-semibold text-primary-900 hover:text-accent-600 group">
        Mulai pilih kebutuhan di Katalog Produk
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
