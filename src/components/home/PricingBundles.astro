---
import { verticalBundles } from "../../data/ratecard";

// Ambil 3 paket utama untuk preview homepage (Paket A, B, C)
const homepageBundles = verticalBundles.slice(0, 3);
---

<section id="pricing" class="py-24 sm:py-32 bg-stone-50 border-t border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-100 text-primary-950 text-xs font-semibold uppercase tracking-wider mb-4 border border-primary-200">
          Katalog Solusi Vertikal
        </div>
        <h2 class="font-sans text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight leading-tight">
          Paket Investasi Berbasis Hasil. <br class="hidden sm:inline" />
          <span class="text-primary-900 font-bold">Transparan, Terukur, & 100% Hak Milik.</span>
        </h2>
        <p class="mt-4 text-base sm:text-lg text-stone-600 leading-relaxed">
          Bukan template generik. Setiap paket dirancang dari modul teruji Akordium dengan delivery cepat (1–7 hari) dan nol biaya langganan bulanan per-user.
        </p>
      </div>

      <div class="shrink-0">
        <a
          href="/catalog"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white border border-stone-300 hover:border-primary-900 hover:bg-stone-50 text-xs font-bold text-stone-800 transition-all shadow-xs"
        >
          <span>Buka Katalog Lengkap (Paket A–E)</span>
          <svg class="w-4 h-4 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- 3 Bundles Grid (A, B, C) - Clean & Compact Modern Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      {homepageBundles.map((bundle) => {
        const isPopular = bundle.popular;
        return (
          <div
            class:list={[
              "relative rounded-2xl flex flex-col justify-between transition-all duration-300",
              isPopular
                ? "bg-white border-2 border-accent-600 shadow-xl shadow-accent-600/10 p-7 md:-translate-y-2"
                : "bg-white border border-stone-200/90 hover:border-stone-300 shadow-xs p-6"
            ]}
          >
            {isPopular && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3.5 py-0.5 rounded-full bg-accent-600 text-white text-[10px] font-bold uppercase tracking-wider shadow-sm">
                Paling Direkomendasikan
              </div>
            )}

            <div>
              <!-- Top Row: Badge & Duration -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class:list={[
                  "text-[10px] font-bold tracking-wider uppercase px-2.5 py-0.5 rounded-md",
                  isPopular ? "bg-accent-50 text-accent-700 border border-accent-200/60" : "bg-stone-100 text-stone-700"
                ]}>
                  {bundle.badge}
                </span>
                <span class="text-xs text-stone-500 font-medium">
                  {bundle.duration}
                </span>
              </div>

              <!-- Bundle Name -->
              <h3 class="font-sans text-xl font-bold text-stone-900 leading-snug">
                {bundle.name}
              </h3>

              <!-- Price Box: Ringkas & Modern ("Rp 5,5jt – 8,5jt") -->
              <div class="mt-4 pt-4 border-t border-stone-100">
                <div class="text-[10px] font-semibold text-stone-400 uppercase tracking-wider">
                  Investasi One-Off
                </div>
                <div class="mt-1 text-2xl lg:text-3xl font-extrabold text-stone-950 font-sans tracking-tight">
                  {bundle.priceCompact}
                </div>
                <!-- SLA: Ringkas di bawah harga -->
                {bundle.slaCompact && (
                  <div class="mt-1.5 text-xs text-stone-500 flex items-center gap-1.5">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span>{bundle.slaCompact}</span>
                  </div>
                )}
              </div>

              <!-- "Cocok untuk": 1 baris singkat informatif -->
              <div class="mt-4 py-2 px-3 rounded-lg bg-stone-50 border border-stone-200/50 text-xs text-stone-600 truncate">
                <span class="font-bold text-stone-800">Cocok:</span> {bundle.targetCompact || bundle.target}
              </div>

              <!-- Highlight Modul Kunci: 3 ringkas dengan link detail (mengurangi clutter) -->
              <div class="mt-4 pt-3 border-t border-stone-100">
                <div class="text-[11px] font-semibold text-stone-500 mb-2 flex items-center justify-between">
                  <span>Modul Utama:</span>
                  <a href="/catalog" class="text-primary-900 hover:text-accent-600 text-[11px] font-medium transition-colors">
                    Lihat detail &rarr;
                  </a>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  {bundle.modulesIncluded.slice(0, 3).map((mod) => (
                    <span class="inline-flex items-center text-[11px] bg-primary-50 text-primary-900 font-medium px-2 py-0.5 rounded-md border border-primary-100/70">
                      {mod}
                    </span>
                  ))}
                  {bundle.modulesIncluded.length > 3 && (
                    <span class="inline-flex items-center text-[10px] text-stone-400 font-medium px-1.5 py-0.5">
                      +{bundle.modulesIncluded.length - 3} lainnya
                    </span>
                  )}
                </div>
              </div>
            </div>

            <!-- CTA -->
            <div class="mt-6 pt-5 border-t border-stone-100">
              <a
                href={`https://wa.me/6281234567890?text=${encodeURIComponent(`Halo Akordium Lab, saya tertarik untuk konsultasi implementasi ${bundle.name}. Mohon info jadwal review kebutuhan.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "w-full py-2.5 px-4 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-all text-center",
                  isPopular
                    ? "bg-accent-600 hover:bg-accent-700 text-white shadow-sm hover:shadow-md hover:shadow-accent-500/20"
                    : "bg-primary-950 hover:bg-primary-900 text-white hover:text-white"
                ]}
              >
                Pilih Paket Ini &rarr;
              </a>
              <p class="text-center text-[10px] text-stone-400 mt-2 font-medium">
                100% Hak Milik · Zero SaaS Tax
              </p>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Catalog & Extended Options Callout -->
    <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-white border border-stone-200/80 flex flex-col lg:flex-row lg:items-center justify-between gap-6 shadow-xs">
      <div class="flex items-start sm:items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary-50 text-primary-900 border border-primary-200 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div>
          <h4 class="text-base font-bold text-stone-900">
            Mencari Paket D (Retail Multi-Cabang), Paket E (Enterprise ERP), atau Custom Engineering?
          </h4>
          <p class="text-xs sm:text-sm text-stone-600 mt-1 leading-relaxed">
            Halaman katalog memuat rincian lengkap seluruh paket A, B, C, D, E, integrasi AI MCP, dan skema kustomisasi bisnis skala besar.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href="/catalog"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary-950 hover:bg-primary-900 text-white text-xs font-bold transition-all shadow-sm"
        >
          Lihat Detail Semua Paket di Katalog &rarr;
        </a>
        <a
          href="#modules"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs font-bold transition-colors"
        >
          Katalog Modul À La Carte &darr;
        </a>
      </div>
    </div>
  </div>
</section>
