---
import { corePractices } from '../../data/services';

const icons: Record<string, string> = {
  layers: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`,
  cpu: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m16-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>`,
  workflow: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM9 14v2a2 2 0 002 2h2m0 0v-2a2 2 0 012-2h2m-4 4v2a1 1 0 01-1 1h-4a1 1 0 01-1-1v-2" /></svg>`,
};
---

<section id="services" class="py-20 lg:py-28 bg-primary-50/20 border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono font-semibold text-primary-900 bg-primary-50 border border-primary-200/80 mb-4 shadow-2xs">
        Layanan Kami
      </div>
      <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold text-stone-900 tracking-tight leading-tight">
        Solusi Nyata untuk Operasional Bisnis Anda
      </h2>
      <p class="mt-4 text-base sm:text-lg text-stone-600 leading-relaxed">
        Bukan sekadar website pajangan. Kami membangun alat kerja internal yang langsung menyelesaikan masalah tim Anda di lapangan dan kantor.
      </p>
    </div>

    <!-- 3 Core Practices Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {corePractices.map((practice) => (
        <div class="bg-white rounded-2xl border border-stone-200/90 p-7 sm:p-8 flex flex-col justify-between hover:border-primary-400 hover:shadow-xl hover:shadow-primary-100/50 transition-all duration-200">
          <div>
            <!-- Card Header: Icon + Badge -->
            <div class="flex items-center justify-between gap-3 mb-6">
              <div class="w-12 h-12 rounded-xl bg-primary-50 border border-primary-200/80 text-primary-700 flex items-center justify-center shrink-0" set:html={icons[practice.icon]} />
              <span class="text-[11px] font-mono font-semibold px-2.5 py-1 rounded bg-primary-50 text-primary-900 border border-primary-200/80">
                {practice.badge}
              </span>
            </div>

            <!-- Title & Tagline -->
            <h3 class="font-sans text-xl font-bold text-stone-900 tracking-tight mb-2">
              {practice.title}
            </h3>
            <p class="text-xs font-semibold text-accent-600 mb-3 font-mono">
              {practice.tagline}
            </p>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed mb-6">
              {practice.description}
            </p>

            <!-- Deliverables List -->
            <div class="space-y-2.5 pt-4 border-t border-stone-100">
              <div class="text-[11px] font-mono uppercase tracking-wider text-stone-400 font-bold">Deliverables</div>
              {practice.deliverables.map((item) => (
                <div class="flex items-start gap-2 text-xs text-stone-700">
                  <svg class="w-4 h-4 text-primary-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Card Footer: Tech Stack Tags -->
          <div class="pt-6 mt-6 border-t border-stone-100">
            <div class="flex flex-wrap gap-1.5">
              {practice.techStack.map((tech) => (
                <span class="px-2 py-0.5 rounded bg-primary-50/60 border border-primary-100 text-[10px] font-mono text-primary-800 font-medium">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Bridge -->
    <div class="mt-12 text-center">
      <p class="text-xs sm:text-sm text-stone-500">
        Punya tantangan arsitektur di luar tiga pilar di atas? 
        <a href="#contact" class="font-semibold text-primary-900 underline hover:text-accent-600 ml-1">
          Diskusikan sistem khusus bersama kami &rarr;
        </a>
      </p>
    </div>

  </div>
</section>
